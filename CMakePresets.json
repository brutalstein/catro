{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-msvc",
      "displayName": "Windows x64 (MSVC)",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/out/build/windows-msvc",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CATRO_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "macos-clang",
      "displayName": "macOS native architecture (AppleClang)",
      "generator": "Xcode",
      "binaryDir": "${sourceDir}/out/build/macos-clang",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CATRO_BUILD_TESTS": "ON",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "12.3"
      }
    },
    {
      "name": "macos-universal",
      "inherits": "macos-clang",
      "displayName": "macOS universal",
      "binaryDir": "${sourceDir}/out/build/macos-universal",
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "arm64;x86_64"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-debug",
      "configurePreset": "windows-msvc",
      "configuration": "Debug"
    },
    {
      "name": "macos-debug",
      "configurePreset": "macos-clang",
      "configuration": "Debug"
    },
    {
      "name": "macos-universal-debug",
      "configurePreset": "macos-universal",
      "configuration": "Debug"
    }
  ],
  "testPresets": [
    {
      "name": "windows-debug",
      "configurePreset": "windows-msvc",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "macos-debug",
      "configurePreset": "macos-clang",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}

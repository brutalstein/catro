<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Catro.ShareView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="1040"
                    Padding="32,28,32,36"
                    Spacing="22">
            <StackPanel Spacing="6">
                <TextBlock Text="SCREEN SHARE" Style="{StaticResource CatroEyebrowTextStyle}" />
                <TextBlock Text="Share only what matters."
                           Style="{StaticResource CatroPageTitleTextStyle}"
                           AutomationProperties.HeadingLevel="Level1" />
                <TextBlock Text="The UI is already split into source, quality, and audio boundaries so native capture can plug in without redesigning the shell."
                           MaxWidth="720"
                           Style="{StaticResource CatroSecondaryTextStyle}" />
            </StackPanel>

            <Border Style="{StaticResource CatroCardStyle}" Padding="22">
                <Grid ColumnSpacing="22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="280" />
                    </Grid.ColumnDefinitions>
                    <Border Height="280"
                            CornerRadius="16"
                            Background="{ThemeResource CatroSurfaceAltBrush}">
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="12">
                            <Border Width="58" Height="58"
                                    CornerRadius="18"
                                    Background="{ThemeResource CatroWarmSoftBrush}">
                                <FontIcon Glyph="&#xE7F4;"
                                          FontSize="22"
                                          Foreground="{ThemeResource CatroAccentBrush}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="No source selected"
                                       HorizontalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource CatroTextBrush}" />
                            <TextBlock Text="Window and display capture land here."
                                       HorizontalAlignment="Center"
                                       Style="{StaticResource CatroSecondaryTextStyle}" />
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="1" Spacing="12">
                        <Border Style="{StaticResource CatroSoftCardStyle}" Padding="16">
                            <StackPanel Spacing="5">
                                <TextBlock Text="SOURCE" Style="{StaticResource CatroEyebrowTextStyle}" />
                                <TextBlock Text="Window or display"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource CatroTextBrush}" />
                                <TextBlock Text="Native picker connection reserved."
                                           Style="{StaticResource CatroSecondaryTextStyle}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CatroSoftCardStyle}" Padding="16">
                            <StackPanel Spacing="5">
                                <TextBlock Text="QUALITY" Style="{StaticResource CatroEyebrowTextStyle}" />
                                <TextBlock Text="Adaptive by hardware"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource CatroTextBrush}" />
                                <TextBlock Text="Encoder capability plan connects here."
                                           Style="{StaticResource CatroSecondaryTextStyle}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CatroSoftCardStyle}" Padding="16">
                            <StackPanel Spacing="5">
                                <TextBlock Text="AUDIO" Style="{StaticResource CatroEyebrowTextStyle}" />
                                <TextBlock Text="System + microphone"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource CatroTextBrush}" />
                                <TextBlock Text="Mix policy remains outside the UI callback."
                                           Style="{StaticResource CatroSecondaryTextStyle}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource CatroCardStyle}" Padding="18">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Start share"
                                   Style="{StaticResource CatroSectionTitleTextStyle}" />
                        <TextBlock Text="Disabled until the native capture milestone is connected."
                                   Style="{StaticResource CatroSecondaryTextStyle}" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="Choose source"
                            IsEnabled="False"
                            Style="{StaticResource CatroPrimaryButtonStyle}" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

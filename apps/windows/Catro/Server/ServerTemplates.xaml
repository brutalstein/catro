<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="CatroStretchListItemStyle" TargetType="ListViewItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <DataTemplate x:Key="CatroMessageTemplate">
        <StackPanel Margin="8,7" Spacing="2">
            <Border Margin="0,8,0,10" Padding="0,5"
                    BorderThickness="0,1,0,0"
                    BorderBrush="{ThemeResource CatroStrokeBrush}">
                <TextBlock HorizontalAlignment="Center" FontSize="11"
                           Foreground="{ThemeResource CatroTextTertiaryBrush}" />
            </Border>
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource CatroTextBrush}" />
                <TextBlock FontSize="11"
                           Grid.Column="1"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource CatroTextTertiaryBrush}" />
            </Grid>
            <TextBlock FontSize="14"
                       TextWrapping="Wrap"
                       IsTextSelectionEnabled="True"
                       Foreground="{ThemeResource CatroTextBrush}" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="CatroMemberTemplate">
        <Grid Margin="0,5" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="32"
                    Height="32"
                    CornerRadius="16"
                    BorderThickness="2"
                    BorderBrush="Transparent"
                    Background="{ThemeResource CatroAccentSoftBrush}">
                <TextBlock FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource CatroAccentBrush}" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock FontSize="13"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource CatroTextBrush}" />
                <TextBlock FontSize="11"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource CatroTextTertiaryBrush}" />
            </StackPanel>
        </Grid>
    </DataTemplate>
</ResourceDictionary>

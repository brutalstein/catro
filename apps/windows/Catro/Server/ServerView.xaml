<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Catro.ServerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="ServerLayout"
          Background="{ThemeResource CatroBackgroundBrush}"
          SizeChanged="OnSizeChanged">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ChannelsColumn" Width="232" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="MembersColumn" Width="216" />
        </Grid.ColumnDefinitions>

        <!-- Server / channel navigation. Fixed-size, flat, and intentionally close to the mental
             model users already know from gaming chat apps. -->
        <Border Background="{ThemeResource CatroSurfaceBrush}"
                BorderBrush="{ThemeResource CatroStrokeBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="48" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="54" />
                </Grid.RowDefinitions>

                <Grid Padding="14,0,10,0"
                      BorderBrush="{ThemeResource CatroStrokeBrush}"
                      BorderThickness="0,0,0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal"
                                Spacing="7"
                                VerticalAlignment="Center">
                        <TextBlock Text="My Server"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource CatroTextBrush}"
                                   VerticalAlignment="Center" />
                        <FontIcon Glyph="&#xE735;"
                                  FontSize="11"
                                  Foreground="{ThemeResource CatroAccentBrush}"
                                  ToolTipService.ToolTip="Owner" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Width="30"
                            Height="30"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            IsEnabled="False"
                            ToolTipService.ToolTip="Invite"
                            AutomationProperties.Name="Invite">
                        <FontIcon Glyph="&#xE8FA;" FontSize="14" />
                    </Button>
                </Grid>

                <StackPanel Grid.Row="1"
                            Padding="8,14,8,8"
                            Spacing="14">
                    <StackPanel Spacing="5">
                        <TextBlock Text="TEXT CHANNELS"
                                   Margin="8,0,0,2"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   CharacterSpacing="80"
                                   Foreground="{ThemeResource CatroTextTertiaryBrush}" />
                        <Grid Height="36">
                            <Border x:Name="TextSelection"
                                    CornerRadius="9"
                                    Background="{ThemeResource CatroSurfaceAltBrush}" />
                            <Button Click="OnTextChannel"
                                    Padding="10,0"
                                    HorizontalContentAlignment="Left"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="{ThemeResource CatroTextBrush}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="#" FontSize="18"
                                               Foreground="{ThemeResource CatroTextSecondaryBrush}" />
                                    <TextBlock Text="general"
                                               VerticalAlignment="Center"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <StackPanel Spacing="5">
                        <TextBlock Text="VOICE CHANNELS"
                                   Margin="8,0,0,2"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   CharacterSpacing="80"
                                   Foreground="{ThemeResource CatroTextTertiaryBrush}" />
                        <Grid Height="36">
                            <Border x:Name="VoiceSelection"
                                    CornerRadius="9"
                                    Background="{ThemeResource CatroSurfaceAltBrush}"
                                    Visibility="Collapsed" />
                            <Button Click="OnVoiceChannel"
                                    Padding="10,0"
                                    HorizontalContentAlignment="Left"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="{ThemeResource CatroTextBrush}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE720;"
                                              FontSize="14"
                                              Foreground="{ThemeResource CatroTextSecondaryBrush}" />
                                    <TextBlock Text="Voice"
                                               VerticalAlignment="Center"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Row="2"
                      Padding="8,0"
                      Background="{ThemeResource CatroSurfaceAltBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                        <Border Width="32"
                                Height="32"
                                CornerRadius="16"
                                Background="{ThemeResource CatroAccentSoftBrush}">
                            <TextBlock Text="Y"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource CatroAccentBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="0">
                            <TextBlock Text="You"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource CatroTextBrush}" />
                            <TextBlock Text="Owner"
                                       FontSize="10"
                                       Foreground="{ThemeResource CatroTextTertiaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="0"
                                VerticalAlignment="Center">
                        <Button Width="28" Height="28" Padding="0"
                                Background="Transparent" BorderThickness="0"
                                IsEnabled="False"
                                ToolTipService.ToolTip="Mute">
                            <FontIcon Glyph="&#xE720;" FontSize="12" />
                        </Button>
                        <Button Width="28" Height="28" Padding="0"
                                Background="Transparent" BorderThickness="0"
                                IsEnabled="False"
                                ToolTipService.ToolTip="Deafen">
                            <FontIcon Glyph="&#xE7F6;" FontSize="12" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Active channel -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Padding="14,0"
                  Background="{ThemeResource CatroBackgroundBrush}"
                  BorderBrush="{ThemeResource CatroStrokeBrush}"
                  BorderThickness="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Width="20" Height="24" VerticalAlignment="Center">
                    <TextBlock x:Name="TextChannelGlyph"
                               Text="#"
                               FontSize="20"
                               Foreground="{ThemeResource CatroTextSecondaryBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                    <FontIcon x:Name="VoiceChannelGlyph"
                              Glyph="&#xE720;"
                              FontSize="14"
                              Foreground="{ThemeResource CatroTextSecondaryBrush}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Visibility="Collapsed" />
                </Grid>
                <TextBlock x:Name="ChannelTitle"
                           Grid.Column="1"
                           Text="general"
                           Margin="8,0,0,0"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource CatroTextBrush}"
                           VerticalAlignment="Center" />

                <StackPanel x:Name="VoiceToolbar"
                            Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="6"
                            Visibility="Collapsed"
                            VerticalAlignment="Center">
                    <Button Content="Share screen"
                            IsEnabled="False"
                            Style="{StaticResource CatroSecondaryButtonStyle}" />
                    <Button Content="Join"
                            IsEnabled="False"
                            Style="{StaticResource CatroPrimaryButtonStyle}" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid x:Name="TextPanel">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="8">
                        <Border Width="54"
                                Height="54"
                                CornerRadius="27"
                                Background="{ThemeResource CatroSurfaceAltBrush}">
                            <TextBlock Text="#"
                                       FontSize="28"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource CatroTextSecondaryBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="# general"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource CatroTextBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <TextBox Grid.Row="1"
                             Margin="14"
                             MinHeight="42"
                             IsEnabled="False"
                             PlaceholderText="Message #general"
                             Background="{ThemeResource CatroSurfaceAltBrush}"
                             BorderThickness="0"
                             CornerRadius="12" />
                </Grid>

                <Grid x:Name="VoicePanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="14">
                        <Border Width="92"
                                Height="92"
                                CornerRadius="46"
                                Background="{ThemeResource CatroAccentSoftBrush}">
                            <Grid>
                                <TextBlock Text="Y"
                                           FontSize="28"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource CatroAccentBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                                <Ellipse Width="16"
                                         Height="16"
                                         Fill="{ThemeResource CatroSageBrush}"
                                         Stroke="{ThemeResource CatroBackgroundBrush}"
                                         StrokeThickness="3"
                                         HorizontalAlignment="Right"
                                         VerticalAlignment="Bottom"
                                         Margin="0,0,4,4" />
                            </Grid>
                        </Border>
                        <TextBlock Text="You"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource CatroTextBrush}"
                                   HorizontalAlignment="Center" />
                        <Border Padding="8,3"
                                CornerRadius="8"
                                Background="{ThemeResource CatroAccentSoftBrush}"
                                HorizontalAlignment="Center">
                            <TextBlock Text="OWNER"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       CharacterSpacing="70"
                                       Foreground="{ThemeResource CatroAccentBrush}" />
                        </Border>
                    </StackPanel>

                    <Border Grid.Row="1"
                            Margin="14"
                            Padding="10"
                            CornerRadius="14"
                            Background="{ThemeResource CatroSurfaceBrush}"
                            BorderBrush="{ThemeResource CatroStrokeBrush}"
                            BorderThickness="1">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Spacing="8">
                            <Button Width="38" Height="38" Padding="0"
                                    IsEnabled="False"
                                    Style="{StaticResource CatroSecondaryButtonStyle}"
                                    ToolTipService.ToolTip="Mute">
                                <FontIcon Glyph="&#xE720;" FontSize="14" />
                            </Button>
                            <Button Width="38" Height="38" Padding="0"
                                    IsEnabled="False"
                                    Style="{StaticResource CatroSecondaryButtonStyle}"
                                    ToolTipService.ToolTip="Deafen">
                                <FontIcon Glyph="&#xE7F6;" FontSize="14" />
                            </Button>
                            <Button Width="38" Height="38" Padding="0"
                                    IsEnabled="False"
                                    Style="{StaticResource CatroSecondaryButtonStyle}"
                                    ToolTipService.ToolTip="Share screen">
                                <FontIcon Glyph="&#xE7F4;" FontSize="14" />
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- Members -->
        <Border x:Name="MembersPane"
                Grid.Column="2"
                Background="{ThemeResource CatroSurfaceBrush}"
                BorderBrush="{ThemeResource CatroStrokeBrush}"
                BorderThickness="1,0,0,0">
            <StackPanel Padding="14,16" Spacing="12">
                <TextBlock Text="MEMBERS — 1"
                           FontSize="10"
                           FontWeight="SemiBold"
                           CharacterSpacing="80"
                           Foreground="{ThemeResource CatroTextTertiaryBrush}" />

                <Grid Height="42">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="30" Height="30">
                        <Border CornerRadius="15"
                                Background="{ThemeResource CatroAccentSoftBrush}">
                            <TextBlock Text="Y"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource CatroAccentBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <Ellipse Width="10"
                                 Height="10"
                                 Fill="{ThemeResource CatroSageBrush}"
                                 Stroke="{ThemeResource CatroSurfaceBrush}"
                                 StrokeThickness="2"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Bottom" />
                    </Grid>
                    <TextBlock Grid.Column="1"
                               Text="You"
                               Margin="7,0,0,0"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource CatroTextBrush}"
                               VerticalAlignment="Center" />
                    <FontIcon Grid.Column="2"
                              Glyph="&#xE735;"
                              FontSize="11"
                              Foreground="{ThemeResource CatroAccentBrush}"
                              VerticalAlignment="Center"
                              ToolTipService.ToolTip="Owner" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

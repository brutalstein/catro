<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Catro.ServerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="ServerLayout"
          Background="{ThemeResource CatroBackgroundBrush}"
          SizeChanged="OnSizeChanged">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ChannelsColumn" Width="232" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="MembersColumn" Width="216" />
        </Grid.ColumnDefinitions>

        <!-- Server / channel navigation. Fixed-size, flat, and intentionally close to the mental
             model users already know from gaming chat apps. -->
        <Border Background="{ThemeResource CatroSurfaceBrush}"
                BorderBrush="{ThemeResource CatroStrokeBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="48" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="54" />
                </Grid.RowDefinitions>

                <Grid Padding="14,0,10,0"
                      BorderBrush="{ThemeResource CatroStrokeBrush}"
                      BorderThickness="0,0,0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal"
                                Spacing="7"
                                VerticalAlignment="Center">
                        <TextBlock x:Name="ServerName"
                                   Text="My Server"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource CatroTextBrush}"
                                   VerticalAlignment="Center" />
                        <FontIcon x:Name="ServerOwnerIcon"
                                  Glyph="&#xE735;"
                                  FontSize="11"
                                  Foreground="{ThemeResource CatroAccentBrush}"
                                  ToolTipService.ToolTip="Owner" />
                    </StackPanel>
                    <Button x:Name="AccessButton"
                            Grid.Column="1"
                            Width="34"
                            Height="30"
                            Padding="0"
                            Margin="0,0,2,0"
                            Background="Transparent"
                            BorderThickness="0"
                            Visibility="Collapsed"
                            IsEnabled="False"
                            Click="OnAccess"
                            ToolTipService.ToolTip="Server access"
                            AutomationProperties.Name="Server access">
                        <Grid>
                            <FontIcon Glyph="&#xE77B;"
                                      FontSize="13" />
                            <Border HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    MinWidth="13"
                                    Height="13"
                                    CornerRadius="7"
                                    Padding="2,0"
                                    Background="{ThemeResource CatroAccentSoftBrush}">
                                <TextBlock x:Name="AccessRequestCount"
                                           Text="0"
                                           FontSize="8"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource CatroAccentBrush}" />
                            </Border>
                        </Grid>
                    </Button>
                    <Button x:Name="InviteButton"
                            Grid.Column="2"
                            Width="30"
                            Height="30"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            IsEnabled="False"
                            Click="OnInvite"
                            ToolTipService.ToolTip="Direct invite"
                            AutomationProperties.Name="Invite">
                        <FontIcon Glyph="&#xE8FA;" FontSize="14" />
                    </Button>
                </Grid>

                <StackPanel Grid.Row="1"
                            Padding="8,14,8,8"
                            Spacing="14">
                    <StackPanel Spacing="5">
                        <TextBlock Text="TEXT CHANNELS"
                                   Margin="8,0,0,2"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   CharacterSpacing="80"
                                   Foreground="{ThemeResource CatroTextTertiaryBrush}" />
                        <Grid Height="36">
                            <Border x:Name="TextSelection"
                                    CornerRadius="9"
                                    Background="{ThemeResource CatroSurfaceAltBrush}" />
                            <Button Click="OnTextChannel"
                                    Padding="10,0"
                                    HorizontalContentAlignment="Left"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="{ThemeResource CatroTextBrush}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="#" FontSize="18"
                                               Foreground="{ThemeResource CatroTextSecondaryBrush}" />
                                    <TextBlock x:Name="TextChannelName"
                                               Text="general"
                                               VerticalAlignment="Center"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <StackPanel Spacing="5">
                        <TextBlock Text="VOICE CHANNELS"
                                   Margin="8,0,0,2"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   CharacterSpacing="80"
                                   Foreground="{ThemeResource CatroTextTertiaryBrush}" />
                        <Grid Height="36">
                            <Border x:Name="VoiceSelection"
                                    CornerRadius="9"
                                    Background="{ThemeResource CatroSurfaceAltBrush}"
                                    Visibility="Collapsed" />
                            <Button Click="OnVoiceChannel"
                                    Padding="10,0"
                                    HorizontalContentAlignment="Left"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="{ThemeResource CatroTextBrush}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE720;"
                                              FontSize="14"
                                              Foreground="{ThemeResource CatroTextSecondaryBrush}" />
                                    <TextBlock x:Name="VoiceChannelName"
                                               Text="Voice"
                                               VerticalAlignment="Center"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Row="2"
                      Padding="8,0"
                      Background="{ThemeResource CatroSurfaceAltBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                        <Border Width="32"
                                Height="32"
                                CornerRadius="16"
                                Background="{ThemeResource CatroAccentSoftBrush}">
                            <TextBlock Text="Y"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource CatroAccentBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="0">
                            <TextBlock x:Name="ProfileName"
                                       Text="You"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource CatroTextBrush}" />
                            <TextBlock x:Name="ProfileRoleText"
                                       Text="Owner"
                                       FontSize="10"
                                       Foreground="{ThemeResource CatroTextTertiaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="0"
                                VerticalAlignment="Center">
                        <Button x:Name="ProfileMuteButton"
                                Width="28" Height="28" Padding="0"
                                Background="Transparent" BorderThickness="0"
                                IsEnabled="False"
                                Click="OnMuteVoice"
                                ToolTipService.ToolTip="Mute">
                            <FontIcon Glyph="&#xE720;" FontSize="12" />
                        </Button>
                        <Button x:Name="ProfileDeafenButton"
                                Width="28" Height="28" Padding="0"
                                Background="Transparent" BorderThickness="0"
                                IsEnabled="False"
                                Click="OnDeafenVoice"
                                ToolTipService.ToolTip="Deafen">
                            <FontIcon Glyph="&#xE7F6;" FontSize="12" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Active channel -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="ChannelHeaderRow" Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Padding="14,0"
                  Background="{ThemeResource CatroBackgroundBrush}"
                  BorderBrush="{ThemeResource CatroStrokeBrush}"
                  BorderThickness="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Width="20" Height="24" VerticalAlignment="Center">
                    <TextBlock x:Name="TextChannelGlyph"
                               Text="#"
                               FontSize="20"
                               Foreground="{ThemeResource CatroTextSecondaryBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                    <FontIcon x:Name="VoiceChannelGlyph"
                              Glyph="&#xE720;"
                              FontSize="14"
                              Foreground="{ThemeResource CatroTextSecondaryBrush}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Visibility="Collapsed" />
                </Grid>
                <TextBlock x:Name="ChannelTitle"
                           Grid.Column="1"
                           Text="general"
                           Margin="8,0,0,0"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource CatroTextBrush}"
                           VerticalAlignment="Center" />

                <StackPanel x:Name="VoiceToolbar"
                            Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="6"
                            Visibility="Collapsed"
                            VerticalAlignment="Center">
                    <Button x:Name="ShareScreenButton"
                            Content="Share screen"
                            IsEnabled="False"
                            Click="OnShareScreen"
                            Style="{StaticResource CatroSecondaryButtonStyle}" />
                    <Button x:Name="JoinVoiceButton"
                            Content="Join"
                            Click="OnJoinVoice"
                            Style="{StaticResource CatroPrimaryButtonStyle}" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid x:Name="TextPanel">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition x:Name="VoiceControlsRow" Height="Auto" />
                    </Grid.RowDefinitions>

                    <ListView x:Name="MessageList"
                              Grid.Row="0"
                              Margin="8,8,8,0"
                              Padding="6,4,6,8"
                              SelectionMode="None"
                              IsItemClickEnabled="False"
                              IsTabStop="False"
                              ScrollViewer.HorizontalScrollMode="Disabled"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollMode="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           Margin="8,6"
                                           TextWrapping="Wrap"
                                           IsTextSelectionEnabled="True"
                                           Foreground="{ThemeResource CatroTextSecondaryBrush}" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel x:Name="TextEmptyState"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="8">
                        <Border Width="54"
                                Height="54"
                                CornerRadius="27"
                                Background="{ThemeResource CatroSurfaceAltBrush}">
                            <TextBlock Text="#"
                                       FontSize="28"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource CatroTextSecondaryBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <TextBlock x:Name="TextEmptyTitle"
                                   Text="# general"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource CatroTextBrush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="This is the beginning of the channel."
                                   FontSize="12"
                                   Foreground="{ThemeResource CatroTextTertiaryBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Row="1"
                                Margin="14,6,14,14"
                                Spacing="5">
                        <TextBlock x:Name="TextStatusText"
                                   FontSize="11"
                                   Foreground="{ThemeResource CatroTextTertiaryBrush}"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     MinHeight="42"
                                     MaxLength="2000"
                                     IsEnabled="False"
                                     x:Name="Composer"
                                     PlaceholderText="Message #general"
                                     Background="{ThemeResource CatroSurfaceAltBrush}"
                                     BorderThickness="0"
                                     CornerRadius="12"
                                     KeyDown="OnComposerKeyDown" />
                            <Button Grid.Column="1"
                                    x:Name="SendMessageButton"
                                    Content="Send"
                                    MinWidth="72"
                                    IsEnabled="False"
                                    Click="OnSendMessage" />
                        </Grid>
                    </StackPanel>
                </Grid>

                <Grid x:Name="VoicePanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel x:Name="VoiceIdentityPanel"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="14">
                        <Border Width="92"
                                Height="92"
                                CornerRadius="46"
                                Background="{ThemeResource CatroAccentSoftBrush}">
                            <Grid>
                                <TextBlock Text="Y"
                                           FontSize="28"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource CatroAccentBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                                <Ellipse Width="16"
                                         Height="16"
                                         Fill="{ThemeResource CatroSageBrush}"
                                         Stroke="{ThemeResource CatroBackgroundBrush}"
                                         StrokeThickness="3"
                                         HorizontalAlignment="Right"
                                         VerticalAlignment="Bottom"
                                         Margin="0,0,4,4" />
                            </Grid>
                        </Border>
                        <TextBlock x:Name="VoiceLocalName"
                                   Text="You"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource CatroTextBrush}"
                                   HorizontalAlignment="Center" />
                        <Border x:Name="VoiceRoleBadge"
                                Padding="8,3"
                                CornerRadius="8"
                                Background="{ThemeResource CatroAccentSoftBrush}"
                                HorizontalAlignment="Center">
                            <TextBlock x:Name="VoiceRoleText"
                                       Text="OWNER"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       CharacterSpacing="70"
                                       Foreground="{ThemeResource CatroAccentBrush}" />
                        </Border>
                        <TextBlock x:Name="VoiceStateText"
                                   Text="Not joined"
                                   FontSize="11"
                                   Foreground="{ThemeResource CatroTextTertiaryBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <Border x:Name="RemoteStreamInvite"
                            Visibility="Collapsed"
                            Margin="22"
                            Padding="18"
                            MaxWidth="430"
                            CornerRadius="14"
                            Background="{ThemeResource CatroSurfaceBrush}"
                            BorderBrush="{ThemeResource CatroStrokeBrush}"
                            BorderThickness="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Border Padding="8,4"
                                        CornerRadius="8"
                                        Background="{ThemeResource CatroSageBrush}">
                                    <TextBlock Text="LIVE"
                                               FontSize="9"
                                               FontWeight="SemiBold"
                                               CharacterSpacing="70"
                                               Foreground="{ThemeResource CatroBackgroundBrush}" />
                                </Border>
                                <TextBlock Text="A stream is live"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource CatroTextBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="Stay in voice and watch only when you want."
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource CatroTextSecondaryBrush}" />
                            <Button x:Name="WatchStreamButton"
                                    Content="Watch Stream"
                                    Click="OnWatchStream"
                                    HorizontalAlignment="Left"
                                    Style="{StaticResource CatroPrimaryButtonStyle}" />
                        </StackPanel>
                    </Border>

                    <Grid x:Name="RemoteShareHost"
                          Visibility="Collapsed"
                          Margin="22"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border x:Name="RemoteShareViewport"
                                Width="720"
                                Height="405"
                                CornerRadius="14"
                                Background="Black"
                                BorderBrush="{ThemeResource CatroStrokeBrush}"
                                BorderThickness="1">
                            <Grid>
                                <SwapChainPanel x:Name="RemoteShareSwapChainPanel"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch" />
                                <Grid Margin="10"
                                      VerticalAlignment="Top">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Padding="8,4"
                                            CornerRadius="8"
                                            Background="{ThemeResource CatroSurfaceBrush}">
                                        <TextBlock Text="LIVE"
                                                   FontSize="9"
                                                   FontWeight="SemiBold"
                                                   CharacterSpacing="70"
                                                   Foreground="{ThemeResource CatroSageBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="2"
                                                Orientation="Horizontal"
                                                Spacing="6">
                                        <Button x:Name="PopOutStreamButton"
                                                Content="Pop Out"
                                                Click="OnPopOutStream"
                                                Padding="10,5"
                                                Style="{StaticResource CatroSecondaryButtonStyle}" />
                                        <Button x:Name="FullScreenStreamButton"
                                                Content="Full Screen"
                                                Click="OnFullScreenStream"
                                                Padding="10,5"
                                                Style="{StaticResource CatroSecondaryButtonStyle}" />
                                        <Button x:Name="LeaveStreamButton"
                                                Content="Leave Stream"
                                                Click="OnLeaveStream"
                                                Padding="10,5"
                                                Style="{StaticResource CatroSecondaryButtonStyle}" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="RemoteShareMetaText"
                                   Grid.Row="1"
                                   Margin="2,10,2,0"
                                   HorizontalAlignment="Center"
                                   FontSize="11"
                                   Foreground="{ThemeResource CatroTextTertiaryBrush}" />
                    </Grid>

                    <Grid x:Name="SharePreviewHost"
                          Visibility="Collapsed"
                          Margin="22"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border x:Name="LocalShareViewport"
                                Width="720"
                                Height="405"
                                CornerRadius="14"
                                Background="Black"
                                BorderBrush="{ThemeResource CatroStrokeBrush}"
                                BorderThickness="1">
                            <Grid>
                                <SwapChainPanel x:Name="LocalShareSwapChainPanel"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch" />
                                <Border Padding="8,4"
                                        Margin="10"
                                        CornerRadius="8"
                                        Background="{ThemeResource CatroSurfaceBrush}"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top">
                                    <TextBlock Text="YOUR STREAM"
                                               FontSize="9"
                                               FontWeight="SemiBold"
                                               CharacterSpacing="70"
                                               Foreground="{ThemeResource CatroAccentBrush}" />
                                </Border>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Row="1"
                                    Margin="2,10,2,0"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Spacing="8">
                            <TextBlock x:Name="ShareSourceText"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource CatroTextBrush}" />
                            <TextBlock x:Name="ShareMetaText"
                                       FontSize="11"
                                       Foreground="{ThemeResource CatroTextTertiaryBrush}" />
                        </StackPanel>
                    </Grid>

                    <Border x:Name="VoiceControlsBar"
                            Grid.Row="1"
                            Margin="14"
                            Padding="10"
                            CornerRadius="14"
                            Background="{ThemeResource CatroSurfaceBrush}"
                            BorderBrush="{ThemeResource CatroStrokeBrush}"
                            BorderThickness="1">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Spacing="8">
                            <Button x:Name="MuteVoiceButton"
                                    Width="38" Height="38" Padding="0"
                                    IsEnabled="False"
                                    Click="OnMuteVoice"
                                    Style="{StaticResource CatroSecondaryButtonStyle}"
                                    ToolTipService.ToolTip="Mute">
                                <FontIcon Glyph="&#xE720;" FontSize="14" />
                            </Button>
                            <Button x:Name="DeafenVoiceButton"
                                    Width="38" Height="38" Padding="0"
                                    IsEnabled="False"
                                    Click="OnDeafenVoice"
                                    Style="{StaticResource CatroSecondaryButtonStyle}"
                                    ToolTipService.ToolTip="Deafen">
                                <FontIcon Glyph="&#xE7F6;" FontSize="14" />
                            </Button>
                            <Button x:Name="ShareScreenIconButton"
                                    Width="38" Height="38" Padding="0"
                                    IsEnabled="False"
                                    Click="OnShareScreen"
                                    Style="{StaticResource CatroSecondaryButtonStyle}"
                                    ToolTipService.ToolTip="Share screen">
                                <FontIcon Glyph="&#xE7F4;" FontSize="14" />
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- Members -->
        <Border x:Name="MembersPane"
                Grid.Column="2"
                Background="{ThemeResource CatroSurfaceBrush}"
                BorderBrush="{ThemeResource CatroStrokeBrush}"
                BorderThickness="1,0,0,0">
            <Grid Padding="14,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="MemberCountLabel"
                           Text="MEMBERS — 1"
                           FontSize="10"
                           FontWeight="SemiBold"
                           CharacterSpacing="80"
                           Foreground="{ThemeResource CatroTextTertiaryBrush}" />

                <ListView x:Name="MemberList"
                          Grid.Row="1"
                          Margin="0,8,0,0"
                          SelectionMode="None"
                          IsItemClickEnabled="False"
                          IsTabStop="False"
                          ScrollViewer.HorizontalScrollMode="Disabled"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollMode="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                       Margin="4,7"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource CatroTextBrush}" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</UserControl>

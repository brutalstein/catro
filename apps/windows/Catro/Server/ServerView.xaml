<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Catro.ServerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ServerTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid x:Name="ServerLayout"
          Background="{ThemeResource CatroBackgroundBrush}"
          SizeChanged="OnSizeChanged">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ChannelsColumn" Width="240" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="MembersColumn" Width="216" />
        </Grid.ColumnDefinitions>

        <!-- Channel navigation and persistent voice controls. -->
        <Border Background="{ThemeResource CatroSurfaceBrush}"
                BorderBrush="{ThemeResource CatroStrokeBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="76" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="68" />
                </Grid.RowDefinitions>

                <Grid Padding="18,0,12,0"
                      BorderBrush="{ThemeResource CatroStrokeBrush}"
                      BorderThickness="0,0,0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="5" VerticalAlignment="Center">
                        <TextBlock Text="YOUR SPACE" Style="{StaticResource CatroEyebrowTextStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <TextBlock x:Name="ServerName" Text="My Server" MaxWidth="112"
                                       FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource CatroTextBrush}" />
                            <FontIcon x:Name="ServerOwnerIcon" Glyph="&#xE735;" FontSize="11"
                                      Foreground="{ThemeResource CatroAccentBrush}"
                                      ToolTipService.ToolTip="Owner" />
                        </StackPanel>
                    </StackPanel>
                    <Button x:Name="AccessButton"
                            Grid.Column="1"
                            Width="36"
                            Height="36"
                            Padding="0"
                            Margin="0,0,2,0"
                            Background="Transparent"
                            BorderThickness="0"
                            Visibility="Collapsed"
                            IsEnabled="False"
                            Click="OnAccess"
                            ToolTipService.ToolTip="Server access"
                            AutomationProperties.Name="Server access">
                        <Grid>
                            <FontIcon Glyph="&#xE77B;"
                                      FontSize="13" />
                            <Border HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    MinWidth="16"
                                    Height="16"
                                    CornerRadius="8"
                                    Padding="3,0"
                                    Background="{ThemeResource CatroAccentSoftBrush}">
                                <TextBlock x:Name="AccessRequestCount"
                                           Text="0"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource CatroAccentBrush}" />
                            </Border>
                        </Grid>
                    </Button>
                    <Button x:Name="InviteButton"
                            Grid.Column="2"
                            Width="36"
                            Height="36"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            IsEnabled="False"
                            Click="OnInvite"
                            ToolTipService.ToolTip="Direct invite"
                            AutomationProperties.Name="Invite">
                        <FontIcon Glyph="&#xE8FA;" FontSize="14" />
                    </Button>
                </Grid>

                <StackPanel Grid.Row="1"
                            Padding="12,24,12,12"
                            Spacing="26">
                    <StackPanel Spacing="5">
                        <TextBlock Text="TEXT CHANNELS"
                                   Margin="8,0,0,2"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   CharacterSpacing="80"
                                   Foreground="{ThemeResource CatroTextTertiaryBrush}" />
                        <Grid Height="42">
                            <Border x:Name="TextSelection"
                                    CornerRadius="9"
                                    Background="{ThemeResource CatroAccentSoftBrush}" />
                            <Button Click="OnTextChannel"
                                    AutomationProperties.Name="Text channel"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                    Padding="10,0"
                                    HorizontalContentAlignment="Left"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="{ThemeResource CatroTextBrush}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="#" FontSize="18"
                                               Foreground="{ThemeResource CatroTextSecondaryBrush}" />
                                    <TextBlock x:Name="TextChannelName"
                                               Text="general"
                                               VerticalAlignment="Center"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <StackPanel Spacing="5">
                        <TextBlock Text="VOICE CHANNELS"
                                   Margin="8,0,0,2"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   CharacterSpacing="80"
                                   Foreground="{ThemeResource CatroTextTertiaryBrush}" />
                        <Grid Height="42">
                            <Border x:Name="VoiceSelection"
                                    CornerRadius="9"
                                    Background="{ThemeResource CatroAccentSoftBrush}"
                                    Visibility="Collapsed" />
                            <Button Click="OnVoiceChannel"
                                    AutomationProperties.Name="Voice channel"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                    Padding="10,0"
                                    HorizontalContentAlignment="Left"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="{ThemeResource CatroTextBrush}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE720;"
                                              FontSize="14"
                                              Foreground="{ThemeResource CatroTextSecondaryBrush}" />
                                    <TextBlock x:Name="VoiceChannelName"
                                               Text="Voice"
                                               VerticalAlignment="Center"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Row="2"
                      Padding="12,0"
                      Background="{ThemeResource CatroSurfaceAltBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                        <Border Width="32"
                                Height="32"
                                CornerRadius="16"
                                Background="{ThemeResource CatroAccentSoftBrush}">
                            <TextBlock x:Name="ProfileInitial"
                                       Text="Y"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource CatroAccentBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="0">
                            <TextBlock x:Name="ProfileName"
                                       Text="You"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource CatroTextBrush}" />
                            <TextBlock x:Name="ProfileRoleText"
                                       Text="Owner"
                                       FontSize="11"
                                       Foreground="{ThemeResource CatroTextTertiaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="0"
                                VerticalAlignment="Center">
                        <Button x:Name="ProfileMuteButton"
                                Width="36" Height="36" Padding="0"
                                Background="Transparent" BorderThickness="0"
                                IsEnabled="False"
                                Click="OnMuteVoice"
                                ToolTipService.ToolTip="Mute"
                                AutomationProperties.Name="Profile mute microphone">
                            <FontIcon Glyph="&#xE720;" FontSize="12" />
                        </Button>
                        <Button x:Name="ProfileDeafenButton"
                                Width="36" Height="36" Padding="0"
                                Background="Transparent" BorderThickness="0"
                                IsEnabled="False"
                                Click="OnDeafenVoice"
                                ToolTipService.ToolTip="Deafen"
                                AutomationProperties.Name="Profile deafen audio">
                            <FontIcon Glyph="&#xE7F6;" FontSize="12" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Active channel -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="ChannelHeaderRow" Height="76" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Padding="24,0"
                  Background="{ThemeResource CatroBackgroundBrush}"
                  BorderBrush="{ThemeResource CatroStrokeBrush}"
                  BorderThickness="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Width="20" Height="24" VerticalAlignment="Center">
                    <TextBlock x:Name="TextChannelGlyph"
                               Text="#"
                               FontSize="20"
                               Foreground="{ThemeResource CatroTextSecondaryBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                    <FontIcon x:Name="VoiceChannelGlyph"
                              Glyph="&#xE720;"
                              FontSize="14"
                              Foreground="{ThemeResource CatroTextSecondaryBrush}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Visibility="Collapsed" />
                </Grid>
                <StackPanel Grid.Column="1"
                            Margin="8,0,10,0"
                            Spacing="1"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="ChannelTitle"
                               Text="general" FontSize="18"
                               AutomationProperties.HeadingLevel="Level1"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource CatroTextBrush}" />
                    <TextBlock x:Name="OnlineStatusText"
                               Text="Online services are not configured. Local mode remains available."
                               FontSize="11"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{ThemeResource CatroTextTertiaryBrush}"
                               AutomationProperties.LiveSetting="Polite" />
                </StackPanel>

                <StackPanel x:Name="VoiceToolbar"
                            Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="6"
                            Visibility="Collapsed"
                            VerticalAlignment="Center">
                    <Button x:Name="ShareScreenButton"
                            Content="Share screen"
                            IsEnabled="False"
                            Click="OnShareScreen"
                            Style="{StaticResource CatroSecondaryButtonStyle}" />
                    <Button x:Name="JoinVoiceButton"
                            Content="Join"
                            Click="OnJoinVoice"
                            Style="{StaticResource CatroPrimaryButtonStyle}" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid x:Name="TextPanel">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition x:Name="VoiceControlsRow" Height="Auto" />
                    </Grid.RowDefinitions>

                    <ListView x:Name="MessageList"
                              ItemTemplate="{StaticResource CatroMessageTemplate}"
                              Grid.Row="0"
                              Margin="14,14,14,0"
                              Padding="6,4,6,8"
                              SelectionMode="None"
                              IsItemClickEnabled="False"
                              IsTabStop="False"
                              ScrollViewer.HorizontalScrollMode="Disabled"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollMode="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ContainerContentChanging="OnMessageContainerChanging">
                        <!-- Rows are filled in code from the recycled container, so scrolling
                             costs no binding evaluation. -->

                    </ListView>

                    <StackPanel x:Name="TextEmptyState" Margin="32,24" MaxWidth="440"
                                HorizontalAlignment="Left" VerticalAlignment="Center" Spacing="16"
                                IsHitTestVisible="False">
                        <Border Width="64" Height="64" CornerRadius="20" HorizontalAlignment="Left"
                                Background="{ThemeResource CatroAccentSoftBrush}">
                            <TextBlock Text="#" FontSize="32" FontWeight="SemiBold"
                                       Foreground="{ThemeResource CatroAccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="A SPACE FOR YOUR PEOPLE" Style="{StaticResource CatroEyebrowTextStyle}" />
                        <TextBlock x:Name="TextEmptyTitle" Text="# general"
                                   Style="{StaticResource CatroPageTitleTextStyle}" />
                        <TextBlock Text="Good conversations start small. Say hello, share a thought, make yourself at home."
                                   MaxWidth="340" Style="{StaticResource CatroSecondaryTextStyle}" />
                    </StackPanel>

                    <StackPanel Grid.Row="1"
                                Margin="24,12,24,20"
                                Spacing="5">
                        <TextBlock x:Name="TextStatusText"
                                   FontSize="11"
                                   Foreground="{ThemeResource CatroTextTertiaryBrush}"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     MinHeight="42"
                                     MaxLength="2000"
                                     IsEnabled="False"
                                     x:Name="Composer"
                                     TextChanged="OnComposerChanged"
                                     PlaceholderText="Message #general"
                                     Background="{ThemeResource CatroSurfaceAltBrush}"
                                     BorderThickness="0"
                                     CornerRadius="12"
                                     KeyDown="OnComposerKeyDown" />
                            <Button Grid.Column="1"
                                    x:Name="SendMessageButton"
                                    Content="Send"
                                    MinWidth="72"
                                    IsEnabled="False"
                                    Click="OnSendMessage"
                                    Style="{StaticResource CatroPrimaryButtonStyle}" />
                        </Grid>
                    </StackPanel>
                </Grid>

                <Grid x:Name="VoicePanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel x:Name="VoiceIdentityPanel"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="16">
                        <TextBlock Text="VOICE LOUNGE" HorizontalAlignment="Center"
                                   Style="{StaticResource CatroEyebrowTextStyle}" />
                        <Border Width="92"
                                Height="92"
                                CornerRadius="46"
                                Background="{ThemeResource CatroAccentSoftBrush}">
                            <Grid>
                                <TextBlock x:Name="VoiceLocalInitial"
                                           Text="Y"
                                           FontSize="28"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource CatroAccentBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                                <Ellipse Width="16"
                                         Height="16"
                                         Fill="{ThemeResource CatroAccentBrush}"
                                         Stroke="{ThemeResource CatroBackgroundBrush}"
                                         StrokeThickness="3"
                                         HorizontalAlignment="Right"
                                         VerticalAlignment="Bottom"
                                         Margin="0,0,4,4" />
                            </Grid>
                        </Border>
                        <TextBlock x:Name="VoiceLocalName"
                                   Text="You"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource CatroTextBrush}"
                                   HorizontalAlignment="Center" />
                        <Border x:Name="VoiceRoleBadge"
                                Padding="8,3"
                                CornerRadius="8"
                                Background="{ThemeResource CatroAccentSoftBrush}"
                                HorizontalAlignment="Center">
                            <TextBlock x:Name="VoiceRoleText"
                                       Text="OWNER"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       CharacterSpacing="70"
                                       Foreground="{ThemeResource CatroAccentBrush}" />
                        </Border>
                        <TextBlock x:Name="VoiceStateText"
                                   Text="Not joined"
                                   FontSize="14"
                                   Foreground="{ThemeResource CatroTextTertiaryBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <Border x:Name="RemoteStreamInvite"
                            Visibility="Collapsed"
                            Margin="22"
                            Padding="18"
                            MaxWidth="430"
                            CornerRadius="14"
                            Background="{ThemeResource CatroSurfaceBrush}"
                            BorderBrush="{ThemeResource CatroStrokeBrush}"
                            BorderThickness="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Border Padding="8,4"
                                        CornerRadius="8"
                                        Background="{ThemeResource CatroSageBrush}">
                                    <TextBlock Text="LIVE"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               CharacterSpacing="70"
                                               Foreground="{ThemeResource CatroBackgroundBrush}" />
                                </Border>
                                <TextBlock Text="A stream is live"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource CatroTextBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="Stay in voice and watch only when you want."
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource CatroTextSecondaryBrush}" />
                            <Button x:Name="WatchStreamButton"
                                    Content="Watch Stream"
                                    Click="OnWatchStream"
                                    HorizontalAlignment="Left"
                                    Style="{StaticResource CatroPrimaryButtonStyle}" />
                        </StackPanel>
                    </Border>

                    <Grid x:Name="RemoteShareHost"
                          Visibility="Collapsed"
                          Margin="22"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border x:Name="RemoteShareViewport"
                                Width="720"
                                Height="405"
                                CornerRadius="14"
                                Background="Black"
                                BorderBrush="{ThemeResource CatroStrokeBrush}"
                                BorderThickness="1">
                            <Grid>
                                <SwapChainPanel x:Name="RemoteShareSwapChainPanel"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch" />
                                <Grid Margin="10"
                                      VerticalAlignment="Top">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Padding="8,4"
                                            CornerRadius="8"
                                            Background="{ThemeResource CatroSurfaceBrush}">
                                        <TextBlock Text="LIVE"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   CharacterSpacing="70"
                                                   Foreground="{ThemeResource CatroSageBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="2"
                                                Orientation="Horizontal"
                                                Spacing="6">
                                        <FontIcon Glyph="&#xE767;"
                                                  FontSize="14"
                                                  VerticalAlignment="Center"
                                                  Foreground="{ThemeResource CatroTextSecondaryBrush}" />
                                        <Slider x:Name="StreamVolumeSlider"
                                                Width="110"
                                                Minimum="0"
                                                Maximum="200"
                                                StepFrequency="5"
                                                Value="100"
                                                VerticalAlignment="Center"
                                                ValueChanged="OnStreamVolumeChanged"
                                                ToolTipService.ToolTip="Stream volume"
                                                AutomationProperties.Name="Stream volume" />
                                        <Button x:Name="PopOutStreamButton"
                                                Content="Pop Out"
                                                Click="OnPopOutStream"
                                                Padding="10,5"
                                                Style="{StaticResource CatroSecondaryButtonStyle}" />
                                        <Button x:Name="FullScreenStreamButton"
                                                Content="Full Screen"
                                                Click="OnFullScreenStream"
                                                Padding="10,5"
                                                Style="{StaticResource CatroSecondaryButtonStyle}" />
                                        <Button x:Name="LeaveStreamButton"
                                                Content="Leave Stream"
                                                Click="OnLeaveStream"
                                                Padding="10,5"
                                                Style="{StaticResource CatroSecondaryButtonStyle}" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="RemoteShareMetaText"
                                   Grid.Row="1"
                                   Margin="2,10,2,0"
                                   HorizontalAlignment="Center"
                                   FontSize="11"
                                   Foreground="{ThemeResource CatroTextTertiaryBrush}" />
                    </Grid>

                    <Grid x:Name="SharePreviewHost"
                          Visibility="Collapsed"
                          Margin="22"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border x:Name="LocalPreviewPausedHint" Visibility="Collapsed" MaxWidth="360"
                                Padding="24" Style="{StaticResource CatroCardStyle}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Your screen is being shared" Style="{StaticResource CatroSectionTitleTextStyle}" TextWrapping="Wrap" />
                                <TextBlock Text="Self-preview is off to save GPU work. Your friends still see your stream. Enable preview in Settings if you want to see it here."
                                           Style="{StaticResource CatroSecondaryTextStyle}" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="LocalShareViewport"
                                Width="720"
                                Height="405"
                                CornerRadius="14"
                                Background="Black"
                                BorderBrush="{ThemeResource CatroStrokeBrush}"
                                BorderThickness="1">
                            <Grid>
                                <SwapChainPanel x:Name="LocalShareSwapChainPanel"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch" />
                                <Border Padding="8,4"
                                        Margin="10"
                                        CornerRadius="8"
                                        Background="{ThemeResource CatroSurfaceBrush}"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top">
                                    <TextBlock Text="YOUR STREAM"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               CharacterSpacing="70"
                                               Foreground="{ThemeResource CatroAccentBrush}" />
                                </Border>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Row="1"
                                    Margin="2,10,2,0"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Spacing="8">
                            <TextBlock x:Name="ShareSourceText"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource CatroTextBrush}" />
                            <TextBlock x:Name="ShareMetaText"
                                       FontSize="11"
                                       Foreground="{ThemeResource CatroTextTertiaryBrush}" />
                        </StackPanel>
                    </Grid>

                    <Border x:Name="VoiceControlsBar"
                            Grid.Row="1"
                            Margin="24,12,24,20"
                            Padding="12"
                            CornerRadius="14"
                            Background="{ThemeResource CatroSurfaceBrush}"
                            BorderBrush="{ThemeResource CatroStrokeBrush}"
                            BorderThickness="1">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Spacing="8">
                            <Button x:Name="MuteVoiceButton"
                                    Width="44" Height="44" Padding="0"
                                    IsEnabled="False"
                                    Click="OnMuteVoice"
                                    Style="{StaticResource CatroSecondaryButtonStyle}"
                                    ToolTipService.ToolTip="Mute"
                                    AutomationProperties.Name="Mute microphone">
                                <FontIcon Glyph="&#xE720;" FontSize="14" />
                            </Button>
                            <Button x:Name="DeafenVoiceButton"
                                    Width="44" Height="44" Padding="0"
                                    IsEnabled="False"
                                    Click="OnDeafenVoice"
                                    Style="{StaticResource CatroSecondaryButtonStyle}"
                                    ToolTipService.ToolTip="Deafen"
                                    AutomationProperties.Name="Deafen audio">
                                <FontIcon Glyph="&#xE7F6;" FontSize="14" />
                            </Button>
                            <Button x:Name="ShareScreenIconButton"
                                    Width="44" Height="44" Padding="0"
                                    IsEnabled="False"
                                    Click="OnShareScreen"
                                    Style="{StaticResource CatroSecondaryButtonStyle}"
                                    ToolTipService.ToolTip="Share screen"
                                    AutomationProperties.Name="Share screen">
                                <FontIcon Glyph="&#xE7F4;" FontSize="14" />
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- Members -->
        <Border x:Name="MembersPane"
                Grid.Column="2"
                Background="{ThemeResource CatroSurfaceBrush}"
                BorderBrush="{ThemeResource CatroStrokeBrush}"
                BorderThickness="1,0,0,0">
            <Grid Padding="16,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="MemberCountLabel"
                           Text="MEMBERS — 1"
                           FontSize="11"
                           FontWeight="SemiBold"
                           CharacterSpacing="80"
                           Foreground="{ThemeResource CatroTextTertiaryBrush}" />

                <ListView x:Name="MemberList"
                          ItemTemplate="{StaticResource CatroMemberTemplate}"
                          Grid.Row="1"
                          Margin="0,8,0,0"
                          SelectionMode="None"
                          IsItemClickEnabled="False"
                          IsTabStop="False"
                          ScrollViewer.HorizontalScrollMode="Disabled"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollMode="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ContainerContentChanging="OnMemberContainerChanging">

                </ListView>
            </Grid>
        </Border>
    </Grid>
</UserControl>

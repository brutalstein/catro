<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Catro.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1120"
                    Padding="32,28,32,36"
                    Spacing="22"
                    HorizontalAlignment="Stretch">
            <StackPanel Spacing="6">
                <TextBlock Text="HOME" Style="{StaticResource CatroEyebrowTextStyle}" />
                <TextBlock Text="Ready when you are."
                           Style="{StaticResource CatroPageTitleTextStyle}"
                           AutomationProperties.HeadingLevel="Level1" />
                <TextBlock Text="A calm native workspace for voice, sharing, and the people you return to."
                           MaxWidth="650"
                           Style="{StaticResource CatroSecondaryTextStyle}" />
            </StackPanel>

            <Border Style="{StaticResource CatroCardStyle}" Padding="24">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="10" VerticalAlignment="Center">
                        <Border Width="38" Height="38"
                                CornerRadius="12"
                                Background="{ThemeResource CatroAccentSoftBrush}"
                                HorizontalAlignment="Left">
                            <FontIcon Glyph="&#xE720;"
                                      FontSize="17"
                                      Foreground="{ThemeResource CatroAccentBrush}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Voice is the first-class path."
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource CatroTextBrush}" />
                        <TextBlock Text="The shell stays simple while the native audio, Opus, jitter, and transport layers do the expensive work off the UI thread."
                                   MaxWidth="680"
                                   Style="{StaticResource CatroSecondaryTextStyle}" />
                    </StackPanel>
                    <Border Grid.Column="1"
                            Width="120"
                            Height="120"
                            CornerRadius="60"
                            Background="{ThemeResource CatroAccentSoftBrush}"
                            VerticalAlignment="Center">
                        <Grid>
                            <Ellipse Width="66"
                                     Height="66"
                                     Fill="{ThemeResource CatroSurfaceBrush}" />
                            <FontIcon Glyph="&#xE720;"
                                      FontSize="25"
                                      Foreground="{ThemeResource CatroAccentBrush}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource CatroCardStyle}" Padding="18">
                    <StackPanel Spacing="12">
                        <Border Width="32" Height="32" CornerRadius="10"
                                Background="{ThemeResource CatroSageSoftBrush}"
                                HorizontalAlignment="Left">
                            <FontIcon Glyph="&#xE716;"
                                      FontSize="14"
                                      Foreground="{ThemeResource CatroSageBrush}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Voice rooms" Style="{StaticResource CatroSectionTitleTextStyle}" />
                        <TextBlock Text="Fast entry, clear speaking state, minimal chrome."
                                   Style="{StaticResource CatroSecondaryTextStyle}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CatroCardStyle}" Padding="18">
                    <StackPanel Spacing="12">
                        <Border Width="32" Height="32" CornerRadius="10"
                                Background="{ThemeResource CatroWarmSoftBrush}"
                                HorizontalAlignment="Left">
                            <FontIcon Glyph="&#xE7F4;"
                                      FontSize="14"
                                      Foreground="{ThemeResource CatroAccentBrush}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Screen share" Style="{StaticResource CatroSectionTitleTextStyle}" />
                        <TextBlock Text="Native capture and hardware encode will plug into one surface."
                                   Style="{StaticResource CatroSecondaryTextStyle}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CatroCardStyle}" Padding="18">
                    <StackPanel Spacing="12">
                        <Border Width="32" Height="32" CornerRadius="10"
                                Background="{ThemeResource CatroRoseSoftBrush}"
                                HorizontalAlignment="Left">
                            <FontIcon Glyph="&#xE713;"
                                      FontSize="14"
                                      Foreground="{ThemeResource CatroRoseBrush}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="System-aware" Style="{StaticResource CatroSectionTitleTextStyle}" />
                        <TextBlock Text="Device health and performance stay visible without becoming the product."
                                   Style="{StaticResource CatroSecondaryTextStyle}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource CatroCardStyle}" Padding="20">
                    <StackPanel Spacing="14">
                        <Grid>
                            <TextBlock Text="Recent spaces"
                                       Style="{StaticResource CatroSectionTitleTextStyle}" />
                            <TextBlock Text="0"
                                       HorizontalAlignment="Right"
                                       Style="{StaticResource CatroSecondaryTextStyle}" />
                        </Grid>
                        <Border Height="112"
                                CornerRadius="14"
                                Background="{ThemeResource CatroSurfaceAltBrush}">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="5">
                                <TextBlock Text="No recent spaces yet"
                                           HorizontalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource CatroTextBrush}" />
                                <TextBlock Text="Rooms you join will land here."
                                           HorizontalAlignment="Center"
                                           Style="{StaticResource CatroSecondaryTextStyle}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1"
                        Style="{StaticResource CatroCardStyle}"
                        Padding="20">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Local media"
                                   Style="{StaticResource CatroSectionTitleTextStyle}" />
                        <StackPanel Spacing="10">
                            <Grid>
                                <TextBlock Text="Audio core" Style="{StaticResource CatroSecondaryTextStyle}" />
                                <Border HorizontalAlignment="Right"
                                        Padding="8,3"
                                        CornerRadius="9"
                                        Background="{ThemeResource CatroSageSoftBrush}">
                                    <TextBlock Text="READY"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource CatroSageBrush}" />
                                </Border>
                            </Grid>
                            <Grid>
                                <TextBlock Text="Voice transport" Style="{StaticResource CatroSecondaryTextStyle}" />
                                <Border HorizontalAlignment="Right"
                                        Padding="8,3"
                                        CornerRadius="9"
                                        Background="{ThemeResource CatroSageSoftBrush}">
                                    <TextBlock Text="LOCAL"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource CatroSageBrush}" />
                                </Border>
                            </Grid>
                            <Grid>
                                <TextBlock Text="Screen pipeline" Style="{StaticResource CatroSecondaryTextStyle}" />
                                <Border HorizontalAlignment="Right"
                                        Padding="8,3"
                                        CornerRadius="9"
                                        Background="{ThemeResource CatroSurfaceAltBrush}">
                                    <TextBlock Text="NEXT"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource CatroTextTertiaryBrush}" />
                                </Border>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>

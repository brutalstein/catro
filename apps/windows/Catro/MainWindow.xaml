<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Catro.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Catro">
    <Grid Background="{ThemeResource CatroBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar"
              Padding="12,0,148,0"
              Background="{ThemeResource CatroRailBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="CATRO"
                       FontSize="11"
                       FontWeight="SemiBold"
                       CharacterSpacing="120"
                       Foreground="{ThemeResource CatroTextSecondaryBrush}"
                       VerticalAlignment="Center" />
            <TextBlock x:Name="TitleContext"
                       Grid.Column="1"
                       Text="My Server"
                       Margin="16,0,0,0"
                       FontSize="11"
                       Foreground="{ThemeResource CatroTextTertiaryBrush}"
                       VerticalAlignment="Center" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="64" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Server rail. One personal server exists from first run; joined servers slot into
                 this same fixed-width rail later. -->
            <Border Background="{ThemeResource CatroRailBrush}"
                    BorderBrush="{ThemeResource CatroStrokeBrush}"
                    BorderThickness="0,1,1,0">
                <Grid Padding="0,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel HorizontalAlignment="Center" Spacing="8">
                        <Grid Width="44" Height="44">
                            <Border x:Name="ServerSelection"
                                    CornerRadius="15"
                                    Background="{ThemeResource CatroAccentSoftBrush}" />
                            <Button x:Name="ServerButton"
                                    Click="OnServer"
                                    Width="44"
                                    Height="44"
                                    Padding="0"
                                    CornerRadius="15"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    ToolTipService.ToolTip="My Server"
                                    AutomationProperties.Name="My Server">
                                <TextBlock Text="Y"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="{ThemeResource CatroAccentBrush}" />
                            </Button>
                        </Grid>

                        <Button Width="40"
                                Height="40"
                                Padding="0"
                                CornerRadius="14"
                                Background="{ThemeResource CatroSurfaceAltBrush}"
                                BorderThickness="0"
                                IsEnabled="False"
                                ToolTipService.ToolTip="Join with invite code"
                                AutomationProperties.Name="Join server">
                            <FontIcon Glyph="&#xE710;" FontSize="15" />
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Row="1"
                                HorizontalAlignment="Center"
                                Spacing="7">
                        <Grid Width="40" Height="40">
                            <Border x:Name="DiagnosticsSelection"
                                    CornerRadius="13"
                                    Background="{ThemeResource CatroAccentSoftBrush}"
                                    Visibility="Collapsed" />
                            <Button Click="OnDiagnostics"
                                    Width="40"
                                    Height="40"
                                    Padding="0"
                                    CornerRadius="13"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    ToolTipService.ToolTip="System"
                                    AutomationProperties.Name="System">
                                <FontIcon Glyph="&#xE9D9;" FontSize="15" />
                            </Button>
                        </Grid>

                        <Grid Width="40" Height="40">
                            <Border x:Name="SettingsSelection"
                                    CornerRadius="13"
                                    Background="{ThemeResource CatroAccentSoftBrush}"
                                    Visibility="Collapsed" />
                            <Button Click="OnSettings"
                                    Width="40"
                                    Height="40"
                                    Padding="0"
                                    CornerRadius="13"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    ToolTipService.ToolTip="Settings"
                                    AutomationProperties.Name="Settings">
                                <FontIcon Glyph="&#xE713;" FontSize="15" />
                            </Button>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <ContentControl x:Name="WorkspaceHost"
                            Grid.Column="1"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch" />
        </Grid>
    </Grid>
</Window>

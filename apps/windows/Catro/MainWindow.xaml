<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Catro.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Catro">
    <Grid Background="{ThemeResource CatroBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar"
              Padding="12,0,148,0"
              Background="{ThemeResource CatroRailBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="CATRO"
                       FontSize="11"
                       FontWeight="SemiBold"
                       CharacterSpacing="120"
                       Foreground="{ThemeResource CatroTextSecondaryBrush}"
                       VerticalAlignment="Center" />
            <TextBlock x:Name="TitleContext"
                       Grid.Column="1"
                       Text="My Server"
                       Margin="16,0,0,0"
                       FontSize="11"
                       Foreground="{ThemeResource CatroTextTertiaryBrush}"
                       VerticalAlignment="Center" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="64" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Server rail. One personal server exists from first run; joined servers slot into
                 this same fixed-width rail later. -->
            <Border Background="{ThemeResource CatroRailBrush}"
                    BorderBrush="{ThemeResource CatroStrokeBrush}"
                    BorderThickness="0,1,1,0">
                <Grid Padding="0,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel HorizontalAlignment="Center" Spacing="8">
                        <Grid Width="44" Height="44">
                            <Border x:Name="ServerSelection"
                                    CornerRadius="15"
                                    Background="{ThemeResource CatroAccentSoftBrush}" />
                            <Button x:Name="ServerButton"
                                    Click="OnServer"
                                    Width="44"
                                    Height="44"
                                    Padding="0"
                                    CornerRadius="15"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    ToolTipService.ToolTip="My Server"
                                    AutomationProperties.Name="My Server">
                                <TextBlock Text="Y"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="{ThemeResource CatroAccentBrush}" />
                            </Button>
                        </Grid>

                        <StackPanel x:Name="JoinedServersPanel"
                                    HorizontalAlignment="Center"
                                    Spacing="8" />

                        <Button x:Name="JoinServerButton"
                                Width="40"
                                Height="40"
                                Padding="0"
                                CornerRadius="14"
                                Background="{ThemeResource CatroSurfaceAltBrush}"
                                BorderThickness="0"
                                IsEnabled="False"
                                Click="OnJoinServer"
                                ToolTipService.ToolTip="Join with invite code"
                                AutomationProperties.Name="Join server">
                            <FontIcon Glyph="&#xE710;" FontSize="15" />
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Row="1"
                                HorizontalAlignment="Center"
                                Spacing="7">
                        <Grid Width="40" Height="40">
                            <Border x:Name="DiagnosticsSelection"
                                    CornerRadius="13"
                                    Background="{ThemeResource CatroAccentSoftBrush}"
                                    Visibility="Collapsed" />
                            <Button Click="OnDiagnostics"
                                    Width="40"
                                    Height="40"
                                    Padding="0"
                                    CornerRadius="13"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    ToolTipService.ToolTip="System"
                                    AutomationProperties.Name="System">
                                <FontIcon Glyph="&#xE9D9;" FontSize="15" />
                            </Button>
                        </Grid>

                        <Grid Width="40" Height="40">
                            <Border x:Name="SettingsSelection"
                                    CornerRadius="13"
                                    Background="{ThemeResource CatroAccentSoftBrush}"
                                    Visibility="Collapsed" />
                            <Button Click="OnSettings"
                                    Width="40"
                                    Height="40"
                                    Padding="0"
                                    CornerRadius="13"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    ToolTipService.ToolTip="Settings"
                                    AutomationProperties.Name="Settings">
                                <FontIcon Glyph="&#xE713;" FontSize="15" />
                            </Button>
                        </Grid>

                        <!-- Lightweight vector mascot: no bitmap decode, no extra asset I/O, and the
                             animation is driven by the Windows compositor rather than the UI thread. -->
                        <StackPanel Margin="0,7,0,1"
                                    HorizontalAlignment="Center"
                                    Spacing="1"
                                    IsHitTestVisible="False"
                                    AutomationProperties.AccessibilityView="Raw">
                            <Grid x:Name="CatroMascot"
                                  Width="44"
                                  Height="42"
                                  RenderTransformOrigin="0.5,0.5">
                                <Canvas Width="44" Height="42">
                                    <!-- ears -->
                                    <Polygon Points="10,18 14,7 20,17"
                                             Fill="{ThemeResource CatroAccentSoftBrush}" />
                                    <Polygon Points="24,17 30,7 34,18"
                                             Fill="{ThemeResource CatroAccentSoftBrush}" />

                                    <!-- face -->
                                    <Ellipse Canvas.Left="9"
                                             Canvas.Top="13"
                                             Width="26"
                                             Height="25"
                                             Fill="{ThemeResource CatroSurfaceAltBrush}"
                                             Stroke="{ThemeResource CatroStrokeBrush}"
                                             StrokeThickness="1" />

                                    <!-- headphones -->
                                    <Path Data="M 8,25 C 8,13 14,8 22,8 C 30,8 36,13 36,25"
                                          Stroke="{ThemeResource CatroAccentBrush}"
                                          StrokeThickness="3"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" />
                                    <Border Canvas.Left="5"
                                            Canvas.Top="22"
                                            Width="7"
                                            Height="13"
                                            CornerRadius="3.5"
                                            Background="{ThemeResource CatroAccentBrush}" />
                                    <Border Canvas.Left="32"
                                            Canvas.Top="22"
                                            Width="7"
                                            Height="13"
                                            CornerRadius="3.5"
                                            Background="{ThemeResource CatroAccentBrush}" />

                                    <!-- expression -->
                                    <Ellipse Canvas.Left="15"
                                             Canvas.Top="23"
                                             Width="3"
                                             Height="3"
                                             Fill="{ThemeResource CatroTextBrush}" />
                                    <Ellipse Canvas.Left="26"
                                             Canvas.Top="23"
                                             Width="3"
                                             Height="3"
                                             Fill="{ThemeResource CatroTextBrush}" />
                                    <Path Data="M 19,30 C 21,32 23,32 25,30"
                                          Stroke="{ThemeResource CatroTextSecondaryBrush}"
                                          StrokeThickness="1.3"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" />
                                </Canvas>
                            </Grid>
                            <TextBlock Text="CATRO"
                                       FontSize="7"
                                       FontWeight="SemiBold"
                                       CharacterSpacing="130"
                                       Foreground="{ThemeResource CatroTextTertiaryBrush}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <ContentControl x:Name="WorkspaceHost"
                            Grid.Column="1"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch" />
        </Grid>
    </Grid>
</Window>

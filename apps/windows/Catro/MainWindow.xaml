<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Catro.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Catro">
    <Grid Background="{ThemeResource CatroBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar"
              Padding="14,0,148,0"
              Background="{ThemeResource CatroRailBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal"
                        Spacing="9"
                        VerticalAlignment="Center">
                <Border Width="26"
                        Height="26"
                        CornerRadius="9"
                        Background="{ThemeResource CatroAccentSoftBrush}">
                    <TextBlock Text="C"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="{ThemeResource CatroAccentBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="CATRO"
                           FontSize="12"
                           FontWeight="SemiBold"
                           CharacterSpacing="120"
                           Foreground="{ThemeResource CatroTextBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Grid.Column="1"
                       x:Name="TitleSection"
                       Text="Home"
                       Margin="14,0,0,0"
                       VerticalAlignment="Center"
                       Foreground="{ThemeResource CatroTextTertiaryBrush}"
                       FontSize="12" />

            <Border Grid.Column="2"
                    Padding="9,4"
                    CornerRadius="9"
                    Background="{ThemeResource CatroSurfaceAltBrush}"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Ellipse Width="6"
                             Height="6"
                             Fill="{ThemeResource CatroSageBrush}"
                             VerticalAlignment="Center" />
                    <TextBlock Text="NATIVE"
                               FontSize="9"
                               FontWeight="SemiBold"
                               CharacterSpacing="80"
                               Foreground="{ThemeResource CatroTextSecondaryBrush}" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="ShellGrid" Grid.Row="1" SizeChanged="OnShellSizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="72" />
                <ColumnDefinition x:Name="ContextColumn" Width="248" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>


            <Border Background="{ThemeResource CatroRailBrush}"
                    BorderBrush="{ThemeResource CatroStrokeBrush}"
                    BorderThickness="0,1,1,0">
                <Grid Padding="0,12,0,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                        <Grid Width="48" Height="48">
                            <Border x:Name="HomeSelection"
                                    CornerRadius="14"
                                    Background="{ThemeResource CatroAccentSoftBrush}"
                                    Visibility="Collapsed" />
                            <Button x:Name="HomeButton"
                                    Tag="home"
                                    Style="{StaticResource CatroNavButtonStyle}"
                                    Click="OnNavigationClick"
                                    ToolTipService.ToolTip="Home"
                                    AutomationProperties.Name="Home">
                                <FontIcon Glyph="&#xE80F;" FontSize="18" />
                            </Button>
                        </Grid>
                        <Grid Width="48" Height="48">
                            <Border x:Name="VoiceSelection"
                                    CornerRadius="14"
                                    Background="{ThemeResource CatroAccentSoftBrush}"
                                    Visibility="Collapsed" />
                            <Button x:Name="VoiceButton"
                                    Tag="voice"
                                    Style="{StaticResource CatroNavButtonStyle}"
                                    Click="OnNavigationClick"
                                    ToolTipService.ToolTip="Voice"
                                    AutomationProperties.Name="Voice">
                                <FontIcon Glyph="&#xE720;" FontSize="18" />
                            </Button>
                        </Grid>
                        <Grid Width="48" Height="48">
                            <Border x:Name="ShareSelection"
                                    CornerRadius="14"
                                    Background="{ThemeResource CatroAccentSoftBrush}"
                                    Visibility="Collapsed" />
                            <Button x:Name="ShareButton"
                                    Tag="share"
                                    Style="{StaticResource CatroNavButtonStyle}"
                                    Click="OnNavigationClick"
                                    ToolTipService.ToolTip="Screen share"
                                    AutomationProperties.Name="Screen share">
                                <FontIcon Glyph="&#xE7F4;" FontSize="18" />
                            </Button>
                        </Grid>

                        <Border Height="1"
                                Width="28"
                                Margin="0,4"
                                Background="{ThemeResource CatroStrokeBrush}" />

                        <Grid Width="48" Height="48">
                            <Border x:Name="DiagnosticsSelection"
                                    CornerRadius="14"
                                    Background="{ThemeResource CatroAccentSoftBrush}"
                                    Visibility="Collapsed" />
                            <Button x:Name="DiagnosticsButton"
                                    Tag="diagnostics"
                                    Style="{StaticResource CatroNavButtonStyle}"
                                    Click="OnNavigationClick"
                                    ToolTipService.ToolTip="System diagnostics"
                                    AutomationProperties.Name="System diagnostics">
                                <FontIcon Glyph="&#xE9D9;" FontSize="18" />
                            </Button>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Row="1"
                                Spacing="8"
                                HorizontalAlignment="Center">
                        <Grid Width="48" Height="48">
                            <Border x:Name="SettingsSelection"
                                    CornerRadius="14"
                                    Background="{ThemeResource CatroAccentSoftBrush}"
                                    Visibility="Collapsed" />
                            <Button x:Name="SettingsButton"
                                    Tag="settings"
                                    Style="{StaticResource CatroNavButtonStyle}"
                                    Click="OnNavigationClick"
                                    ToolTipService.ToolTip="Settings"
                                    AutomationProperties.Name="Settings">
                                <FontIcon Glyph="&#xE713;" FontSize="18" />
                            </Button>
                        </Grid>

                        <Border Width="38"
                                Height="38"
                                CornerRadius="19"
                                Background="{ThemeResource CatroSurfaceAltBrush}"
                                ToolTipService.ToolTip="Local profile">
                            <TextBlock Text="L"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource CatroTextSecondaryBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="ContextPane"
                    Grid.Column="1"
                    Background="{ThemeResource CatroSurfaceBrush}"
                    BorderBrush="{ThemeResource CatroStrokeBrush}"
                    BorderThickness="0,1,1,0"
                    Padding="18,22">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Spacing="6">
                        <TextBlock x:Name="ContextEyebrow"
                                   Text="LOCAL WORKSPACE"
                                   Style="{StaticResource CatroEyebrowTextStyle}" />
                        <TextBlock x:Name="ContextTitle"
                                   Text="Home"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource CatroTextBrush}" />
                        <TextBlock x:Name="ContextSummary"
                                   Text="A quiet launch surface for rooms, voice, and sharing."
                                   Margin="0,2,0,0"
                                   Style="{StaticResource CatroSecondaryTextStyle}" />
                    </StackPanel>

                    <StackPanel Grid.Row="1"
                                Margin="0,28,0,0"
                                Spacing="12">
                        <Grid>
                            <TextBlock Text="WORKSPACE"
                                       Style="{StaticResource CatroEyebrowTextStyle}" />
                            <TextBlock Text="0"
                                       HorizontalAlignment="Right"
                                       Style="{StaticResource CatroSecondaryTextStyle}" />
                        </Grid>
                        <Border Style="{StaticResource CatroSoftCardStyle}"
                                Padding="14">
                            <StackPanel Spacing="5">
                                <TextBlock x:Name="ContextEmptyTitle"
                                           Text="Nothing pinned yet"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource CatroTextBrush}" />
                                <TextBlock x:Name="ContextEmptyDetail"
                                           Text="Recent rooms and people will appear here without changing the shell layout."
                                           FontSize="12"
                                           Style="{StaticResource CatroSecondaryTextStyle}" />
                            </StackPanel>
                        </Border>
                        <Button Content="New"
                                IsEnabled="False"
                                HorizontalAlignment="Stretch"
                                Style="{StaticResource CatroSecondaryButtonStyle}" />
                    </StackPanel>

                    <Border Grid.Row="2"
                            Padding="12"
                            CornerRadius="12"
                            Background="{ThemeResource CatroSageSoftBrush}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="MEDIA CORE"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       CharacterSpacing="80"
                                       Foreground="{ThemeResource CatroSageBrush}" />
                            <TextBlock Text="Native realtime path ready"
                                       FontSize="12"
                                       Foreground="{ThemeResource CatroTextSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <ContentControl x:Name="WorkspaceHost"
                            Grid.Column="2"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch" />
        </Grid>
    </Grid>
</Window>

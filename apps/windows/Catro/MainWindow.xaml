<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Catro.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Catro">
    <Grid x:Name="ShellRoot"
          Background="{ThemeResource CatroBackgroundBrush}">
        <!-- Control-state overrides must live inside the shell tree: WinUI resolves template
             state brushes from the element up, before it reaches application resources. -->
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>
                    <ResourceDictionary x:Key="Light">
                        <SolidColorBrush x:Key="AccentButtonBackground" Color="#A6512D" />
                        <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#94472A" />
                        <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#A6512D" />
                        <SolidColorBrush x:Key="AccentButtonForeground" Color="#FFFFFF" />
                        <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#FFFFFF" />
                        <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#FFFFFF" />
                        <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
                        <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
                        <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="#EBDDD0" />
                        <SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="#8A7A6B" />
                        <SolidColorBrush x:Key="AccentButtonBorderBrushDisabled" Color="Transparent" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="Dark">
                        <SolidColorBrush x:Key="AccentButtonBackground" Color="#E0906B" />
                        <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#E9A07D" />
                        <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#E0906B" />
                        <SolidColorBrush x:Key="AccentButtonForeground" Color="#1B1410" />
                        <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#1B1410" />
                        <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#1B1410" />
                        <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
                        <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
                        <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="#3A2E26" />
                        <SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="#8F8276" />
                        <SolidColorBrush x:Key="AccentButtonBorderBrushDisabled" Color="Transparent" />
                    </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>
            </ResourceDictionary>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar"
              Padding="12,0,148,0"
              Background="{ThemeResource CatroRailBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="CATRO"
                       FontSize="13"
                       FontWeight="SemiBold"
                       CharacterSpacing="120"
                       Foreground="{ThemeResource CatroTextSecondaryBrush}"
                       VerticalAlignment="Center" />
            <TextBlock x:Name="TitleContext"
                       Grid.Column="1"
                       Text="My Server"
                       Margin="16,0,0,0"
                       FontSize="12"
                       Foreground="{ThemeResource CatroTextTertiaryBrush}"
                       VerticalAlignment="Center" />
            <Border Grid.Column="2" Padding="8,3" Margin="12,0"
                    VerticalAlignment="Center" CornerRadius="6"
                    Background="{ThemeResource CatroSageSoftBrush}"
                    ToolTipService.ToolTip="Automatic efficiency: less UI work in the background; presentation polling sleeps when minimized. Voice stays connected.">
                <TextBlock x:Name="ActivityLabel" Text="AUTO · FOCUSED"
                           FontSize="11" FontWeight="SemiBold" CharacterSpacing="60"
                           Foreground="{ThemeResource CatroSageBrush}" />
            </Border>
        </Grid>

        <!-- Shown only while online services need attention; collapsed once synchronized. -->
        <Border x:Name="ShellStatusBar"
                Grid.Row="1"
                Padding="16,7"
                Background="{ThemeResource CatroWarmSoftBrush}"
                BorderBrush="{ThemeResource CatroStrokeBrush}"
                BorderThickness="0,0,0,1">
            <TextBlock x:Name="ShellStatusText"
                       Text="Connecting to online services…"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Foreground="{ThemeResource CatroTextSecondaryBrush}"
                       AutomationProperties.LiveSetting="Polite" />
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="76" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Server rail. One personal server exists from first run; joined servers slot into
                 this same fixed-width rail later. -->
            <Border Background="{ThemeResource CatroRailBrush}"
                    BorderBrush="{ThemeResource CatroStrokeBrush}"
                    BorderThickness="0,1,1,0">
                <Grid Padding="0,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel HorizontalAlignment="Center" Spacing="8">
                        <Grid Width="44" Height="44">
                            <Border x:Name="ServerSelection"
                                    CornerRadius="15"
                                    Background="{ThemeResource CatroAccentSoftBrush}" />
                            <Button x:Name="ServerButton"
                                    Click="OnServer"
                                    Width="44"
                                    Height="44"
                                    Padding="0"
                                    CornerRadius="15"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    ToolTipService.ToolTip="My Server"
                                    AutomationProperties.Name="My Server">
                                <TextBlock Text="Y"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="{ThemeResource CatroAccentBrush}" />
                            </Button>
                        </Grid>

                        <StackPanel x:Name="JoinedServersPanel"
                                    HorizontalAlignment="Center"
                                    Spacing="8" />

                        <Button x:Name="JoinServerButton"
                                Width="44"
                                Height="44"
                                Padding="0"
                                CornerRadius="14"
                                Background="{ThemeResource CatroSurfaceAltBrush}"
                                BorderThickness="0"
                                Click="OnJoinServer"
                                ToolTipService.ToolTip="Add server"
                                AutomationProperties.Name="Add server">
                            <FontIcon Glyph="&#xE710;" FontSize="16" />
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Row="1"
                                HorizontalAlignment="Center"
                                Spacing="7">
                        <Button Click="OnProfile" Width="44" Height="44" Padding="0" CornerRadius="13"
                                Background="Transparent" BorderThickness="0"
                                ToolTipService.ToolTip="Profile" AutomationProperties.Name="Profile">
                            <FontIcon Glyph="&#xE77B;" FontSize="16" />
                        </Button>

                        <Grid Width="44" Height="44">
                            <Border x:Name="DiagnosticsSelection"
                                    CornerRadius="13"
                                    Background="{ThemeResource CatroAccentSoftBrush}"
                                    Visibility="Collapsed" />
                            <Button Click="OnDiagnostics"
                                    Width="44"
                                    Height="44"
                                    Padding="0"
                                    CornerRadius="13"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    ToolTipService.ToolTip="System"
                                    AutomationProperties.Name="System">
                                <FontIcon Glyph="&#xE9D9;" FontSize="16" />
                            </Button>
                        </Grid>

                        <Grid Width="44" Height="44">
                            <Border x:Name="SettingsSelection"
                                    CornerRadius="13"
                                    Background="{ThemeResource CatroAccentSoftBrush}"
                                    Visibility="Collapsed" />
                            <Button Click="OnSettings"
                                    Width="44"
                                    Height="44"
                                    Padding="0"
                                    CornerRadius="13"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    ToolTipService.ToolTip="Settings"
                                    AutomationProperties.Name="Settings">
                                <FontIcon Glyph="&#xE713;" FontSize="16" />
                            </Button>
                        </Grid>

                        <ContentControl ContentTemplate="{StaticResource CatroMascotTemplate}"
                                        Margin="0,12,0,4" IsTabStop="False"
                                        IsHitTestVisible="False"
                                        AutomationProperties.AccessibilityView="Raw" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" Margin="0,4,12,12" CornerRadius="16"
                    Background="{ThemeResource CatroSurfaceBrush}"
                    BorderBrush="{ThemeResource CatroStrokeBrush}" BorderThickness="1">
                <ContentControl x:Name="WorkspaceHost"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch" />
            </Border>
        </Grid>

        <!-- Startup screen, like Discord's: covers the shell until the first sign-in settles. -->
        <Grid x:Name="StartupSplash" Grid.RowSpan="3" Background="{ThemeResource CatroBackgroundBrush}">
            <Grid.OpacityTransition><ScalarTransition Duration="0:0:0.25" /></Grid.OpacityTransition>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="18" MaxWidth="360">
                <Viewbox Width="96" Height="92" HorizontalAlignment="Center">
                    <ContentControl ContentTemplate="{StaticResource CatroMascotTemplate}" IsTabStop="False" />
                </Viewbox>
                <TextBlock Text="CATRO" HorizontalAlignment="Center" Style="{StaticResource CatroPageTitleTextStyle}" CharacterSpacing="240" />
                <ProgressRing x:Name="StartupRing" IsActive="True" Width="28" Height="28" />
                <TextBlock x:Name="StartupStatusText" Text="Starting Catro…" TextAlignment="Center" TextWrapping="Wrap"
                           Foreground="{ThemeResource CatroTextSecondaryBrush}" AutomationProperties.LiveSetting="Polite" />
                <Button x:Name="StartupOfflineButton" Content="Continue offline" HorizontalAlignment="Center"
                        Visibility="Collapsed" Click="OnContinueOffline" Style="{StaticResource CatroSecondaryButtonStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>

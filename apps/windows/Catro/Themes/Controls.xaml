<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="CatroEyebrowTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="80" />
        <Setter Property="Foreground" Value="{ThemeResource CatroTextTertiaryBrush}" />
    </Style>

    <Style x:Key="CatroPageTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource CatroTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="CatroSectionTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource CatroTextBrush}" />
    </Style>

    <Style x:Key="CatroBodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{ThemeResource CatroTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="CatroSecondaryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CatroBodyTextStyle}">
        <Setter Property="Foreground" Value="{ThemeResource CatroTextSecondaryBrush}" />
    </Style>

    <Style x:Key="CatroCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CatroSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CatroStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
    </Style>

    <Style x:Key="CatroSoftCardStyle" TargetType="Border" BasedOn="{StaticResource CatroCardStyle}">
        <Setter Property="Background" Value="{ThemeResource CatroSurfaceAltBrush}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- Based on AccentButtonStyle so hover, pressed, disabled and on-accent text all come
         from the theme instead of falling back to the stock gray button states. -->
    <Style x:Key="CatroPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="CatroSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="{ThemeResource CatroSurfaceAltBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource CatroTextBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CatroStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="MinHeight" Value="36" />
    </Style>

    <Style x:Key="CatroNavButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Width" Value="48" />
        <Setter Property="Height" Value="48" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource CatroTextSecondaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="CatroChatCopperStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource CatroAccentBrush}" />
    </Style>
    <Style x:Key="CatroChatSageStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource CatroSageBrush}" />
    </Style>
    <Style x:Key="CatroChatRoseStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource CatroRoseBrush}" />
    </Style>

    <!-- Static, shared vector; no decorative render loop. -->
    <DataTemplate x:Key="CatroMascotTemplate">
        <Canvas Width="44" Height="42">
            <Path Data="M 10,20 L 14,7 L 21,16 L 25,16 L 30,7 L 34,20 C 42,44 2,44 10,20"
                  Fill="{ThemeResource CatroSurfaceAltBrush}"
                  Stroke="{ThemeResource CatroStrokeBrush}" StrokeThickness="1" />
            <Path Data="M 7,27 C 7,3 37,3 37,27" Stroke="{ThemeResource CatroAccentBrush}"
                  StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            <Border Canvas.Left="4" Canvas.Top="23" Width="7" Height="13" CornerRadius="3"
                    Background="{ThemeResource CatroAccentBrush}" />
            <Border Canvas.Left="33" Canvas.Top="23" Width="7" Height="13" CornerRadius="3"
                    Background="{ThemeResource CatroAccentBrush}" />
            <Ellipse Canvas.Left="15" Canvas.Top="24" Width="3" Height="3" Fill="{ThemeResource CatroTextBrush}" />
            <Ellipse Canvas.Left="26" Canvas.Top="24" Width="3" Height="3" Fill="{ThemeResource CatroTextBrush}" />
            <Path Data="M 19,31 Q 22,34 25,31" Stroke="{ThemeResource CatroTextSecondaryBrush}" StrokeThickness="1.3" />
        </Canvas>
    </DataTemplate>

</ResourceDictionary>

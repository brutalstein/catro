<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Catro.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="CatroBackgroundBrush" Color="#F6F1EA" />
                    <SolidColorBrush x:Key="CatroRailBrush" Color="#F0E9E0" />
                    <SolidColorBrush x:Key="CatroSurfaceBrush" Color="#FCFAF7" />
                    <SolidColorBrush x:Key="CatroSurfaceAltBrush" Color="#EEE6DC" />
                    <SolidColorBrush x:Key="CatroStrokeBrush" Color="#D9D0C4" />
                    <SolidColorBrush x:Key="CatroTextBrush" Color="#292521" />
                    <SolidColorBrush x:Key="CatroTextSecondaryBrush" Color="#716A63" />
                    <SolidColorBrush x:Key="CatroTextTertiaryBrush" Color="#938A81" />
                    <SolidColorBrush x:Key="CatroAccentBrush" Color="#C8785A" />
                    <SolidColorBrush x:Key="CatroAccentHoverBrush" Color="#B96B50" />
                    <SolidColorBrush x:Key="CatroAccentSoftBrush" Color="#F1D8CC" />
                    <SolidColorBrush x:Key="CatroSageBrush" Color="#6F8E76" />
                    <SolidColorBrush x:Key="CatroSageSoftBrush" Color="#DFE9DF" />
                    <SolidColorBrush x:Key="CatroRoseBrush" Color="#AD6F76" />
                    <SolidColorBrush x:Key="CatroRoseSoftBrush" Color="#F0DEE1" />
                    <SolidColorBrush x:Key="CatroWarmSoftBrush" Color="#EFE2C9" />

                    <!-- WinUI accent-aware controls inherit the same warm palette instead of OS blue. -->
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#C8785A" />
                    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#B96B50" />
                    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#A65D45" />
                    <SolidColorBrush x:Key="AccentFillColorDisabledBrush" Color="#E2CFC6" />
                    <SolidColorBrush x:Key="FocusVisualPrimaryBrush" Color="#C8785A" />
                    <SolidColorBrush x:Key="FocusVisualSecondaryBrush" Color="#FCFAF7" />
                </ResourceDictionary>

                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="CatroBackgroundBrush" Color="#171512" />
                    <SolidColorBrush x:Key="CatroRailBrush" Color="#1C1916" />
                    <SolidColorBrush x:Key="CatroSurfaceBrush" Color="#211E1A" />
                    <SolidColorBrush x:Key="CatroSurfaceAltBrush" Color="#29251F" />
                    <SolidColorBrush x:Key="CatroStrokeBrush" Color="#39332C" />
                    <SolidColorBrush x:Key="CatroTextBrush" Color="#F3EDE6" />
                    <SolidColorBrush x:Key="CatroTextSecondaryBrush" Color="#B0A69C" />
                    <SolidColorBrush x:Key="CatroTextTertiaryBrush" Color="#827970" />
                    <SolidColorBrush x:Key="CatroAccentBrush" Color="#D79072" />
                    <SolidColorBrush x:Key="CatroAccentHoverBrush" Color="#E09C7D" />
                    <SolidColorBrush x:Key="CatroAccentSoftBrush" Color="#3B2A23" />
                    <SolidColorBrush x:Key="CatroSageBrush" Color="#89A08B" />
                    <SolidColorBrush x:Key="CatroSageSoftBrush" Color="#263128" />
                    <SolidColorBrush x:Key="CatroRoseBrush" Color="#C4868C" />
                    <SolidColorBrush x:Key="CatroRoseSoftBrush" Color="#38272A" />
                    <SolidColorBrush x:Key="CatroWarmSoftBrush" Color="#342E22" />

                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#D79072" />
                    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E09C7D" />
                    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#BD785E" />
                    <SolidColorBrush x:Key="AccentFillColorDisabledBrush" Color="#4A3931" />
                    <SolidColorBrush x:Key="FocusVisualPrimaryBrush" Color="#D79072" />
                    <SolidColorBrush x:Key="FocusVisualSecondaryBrush" Color="#211E1A" />
                </ResourceDictionary>

                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="CatroBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="CatroRailBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="CatroSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="CatroSurfaceAltBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
                    <SolidColorBrush x:Key="CatroStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="CatroTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="CatroTextSecondaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="CatroTextTertiaryBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
                    <SolidColorBrush x:Key="CatroAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="CatroAccentHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="CatroAccentSoftBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
                    <SolidColorBrush x:Key="CatroSageBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="CatroSageSoftBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
                    <SolidColorBrush x:Key="CatroRoseBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="CatroRoseSoftBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
                    <SolidColorBrush x:Key="CatroWarmSoftBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Style x:Key="CatroEyebrowTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="120" />
                <Setter Property="Foreground" Value="{ThemeResource CatroTextTertiaryBrush}" />
            </Style>

            <Style x:Key="CatroPageTitleTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="30" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource CatroTextBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="CatroSectionTitleTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="17" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource CatroTextBrush}" />
            </Style>

            <Style x:Key="CatroBodyTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="{ThemeResource CatroTextBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="CatroSecondaryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CatroBodyTextStyle}">
                <Setter Property="Foreground" Value="{ThemeResource CatroTextSecondaryBrush}" />
            </Style>

            <Style x:Key="CatroCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CatroSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CatroStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="18" />
            </Style>

            <Style x:Key="CatroSoftCardStyle" TargetType="Border" BasedOn="{StaticResource CatroCardStyle}">
                <Setter Property="Background" Value="{ThemeResource CatroSurfaceAltBrush}" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>

            <Style x:Key="CatroPrimaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource CatroAccentBrush}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="16,9" />
                <Setter Property="MinHeight" Value="38" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="CatroSecondaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource CatroSurfaceAltBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource CatroTextBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CatroStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="14,8" />
                <Setter Property="MinHeight" Value="38" />
            </Style>

            <Style x:Key="CatroNavButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="48" />
                <Setter Property="Height" Value="48" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{ThemeResource CatroTextSecondaryBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>

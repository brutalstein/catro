<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Catro.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Every text/background pair below meets WCAG AA (4.5:1) at the sizes Catro uses. -->
            <ResourceDictionary.ThemeDictionaries>
                <!-- Ivory: Catro's default appearance. -->
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="CatroBackgroundBrush" Color="#FBF8F1" />
                    <SolidColorBrush x:Key="CatroRailBrush" Color="#F3EDE1" />
                    <SolidColorBrush x:Key="CatroSurfaceBrush" Color="#FFFDF8" />
                    <SolidColorBrush x:Key="CatroSurfaceAltBrush" Color="#F1EADC" />
                    <SolidColorBrush x:Key="CatroStrokeBrush" Color="#E3DACA" />
                    <SolidColorBrush x:Key="CatroTextBrush" Color="#2A241D" />
                    <SolidColorBrush x:Key="CatroTextSecondaryBrush" Color="#5E554A" />
                    <SolidColorBrush x:Key="CatroTextTertiaryBrush" Color="#6F6559" />
                    <SolidColorBrush x:Key="CatroAccentBrush" Color="#A6512D" />
                    <SolidColorBrush x:Key="CatroAccentHoverBrush" Color="#94472A" />
                    <SolidColorBrush x:Key="CatroAccentSoftBrush" Color="#F7E9DF" />
                    <SolidColorBrush x:Key="CatroSageBrush" Color="#46704F" />
                    <SolidColorBrush x:Key="CatroSageSoftBrush" Color="#E6EFE5" />
                    <SolidColorBrush x:Key="CatroRoseBrush" Color="#9E4652" />
                    <SolidColorBrush x:Key="CatroRoseSoftBrush" Color="#F6E3E5" />
                    <SolidColorBrush x:Key="CatroWarmSoftBrush" Color="#F3E7CC" />

                    <!-- WinUI's accent consumers (accent buttons, NavigationView, toggles, focus) use
                         the same terracotta instead of the OS accent. -->
                    <Color x:Key="SystemAccentColor">#A6512D</Color>
                    <Color x:Key="SystemAccentColorLight1">#B8673F</Color>
                    <Color x:Key="SystemAccentColorLight2">#CB8460</Color>
                    <Color x:Key="SystemAccentColorLight3">#DFA88A</Color>
                    <Color x:Key="SystemAccentColorDark1">#94472A</Color>
                    <Color x:Key="SystemAccentColorDark2">#7F3C24</Color>
                    <Color x:Key="SystemAccentColorDark3">#66301D</Color>
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#A6512D" />
                    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#94472A" />
                    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#7F3C24" />
                    <SolidColorBrush x:Key="AccentFillColorDisabledBrush" Color="#E8DCCF" />
                    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#FBEFE8" />
                    <SolidColorBrush x:Key="FocusVisualPrimaryBrush" Color="#A6512D" />
                    <SolidColorBrush x:Key="FocusVisualSecondaryBrush" Color="#FFFDF8" />
                    <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#A6512D" />
                    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#FFFDF8" />
                    <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="#E3DACA" />
                    <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#FBF8F1" />
                    <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#FBF8F1" />
                </ResourceDictionary>

                <!-- Dark: warm espresso with the same terracotta family. -->
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="CatroBackgroundBrush" Color="#161310" />
                    <SolidColorBrush x:Key="CatroRailBrush" Color="#1B1814" />
                    <SolidColorBrush x:Key="CatroSurfaceBrush" Color="#201C18" />
                    <SolidColorBrush x:Key="CatroSurfaceAltBrush" Color="#2A251F" />
                    <SolidColorBrush x:Key="CatroStrokeBrush" Color="#3A332B" />
                    <SolidColorBrush x:Key="CatroTextBrush" Color="#F4EEE6" />
                    <SolidColorBrush x:Key="CatroTextSecondaryBrush" Color="#BFB4A8" />
                    <SolidColorBrush x:Key="CatroTextTertiaryBrush" Color="#9A8F83" />
                    <SolidColorBrush x:Key="CatroAccentBrush" Color="#E0906B" />
                    <SolidColorBrush x:Key="CatroAccentHoverBrush" Color="#E9A07D" />
                    <SolidColorBrush x:Key="CatroAccentSoftBrush" Color="#3D2A21" />
                    <SolidColorBrush x:Key="CatroSageBrush" Color="#8FB295" />
                    <SolidColorBrush x:Key="CatroSageSoftBrush" Color="#24302A" />
                    <SolidColorBrush x:Key="CatroRoseBrush" Color="#D58C95" />
                    <SolidColorBrush x:Key="CatroRoseSoftBrush" Color="#3A2629" />
                    <SolidColorBrush x:Key="CatroWarmSoftBrush" Color="#352E22" />

                    <Color x:Key="SystemAccentColor">#E0906B</Color>
                    <Color x:Key="SystemAccentColorLight1">#E9A07D</Color>
                    <Color x:Key="SystemAccentColorLight2">#F0B497</Color>
                    <Color x:Key="SystemAccentColorLight3">#F6CAB4</Color>
                    <Color x:Key="SystemAccentColorDark1">#CC7F5C</Color>
                    <Color x:Key="SystemAccentColorDark2">#B06A4A</Color>
                    <Color x:Key="SystemAccentColorDark3">#8F553B</Color>
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#E0906B" />
                    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E9A07D" />
                    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#CC7F5C" />
                    <SolidColorBrush x:Key="AccentFillColorDisabledBrush" Color="#4A3A31" />
                    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#1B1410" />
                    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#3A2A21" />
                    <SolidColorBrush x:Key="FocusVisualPrimaryBrush" Color="#E0906B" />
                    <SolidColorBrush x:Key="FocusVisualSecondaryBrush" Color="#201C18" />
                    <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#E0906B" />
                    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#201C18" />
                    <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="#3A332B" />
                    <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#161310" />
                    <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#161310" />
                </ResourceDictionary>

                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="CatroBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="CatroRailBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="CatroSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="CatroSurfaceAltBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
                    <SolidColorBrush x:Key="CatroStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="CatroTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="CatroTextSecondaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="CatroTextTertiaryBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
                    <SolidColorBrush x:Key="CatroAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="CatroAccentHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="CatroAccentSoftBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
                    <SolidColorBrush x:Key="CatroSageBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="CatroSageSoftBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
                    <SolidColorBrush x:Key="CatroRoseBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="CatroRoseSoftBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
                    <SolidColorBrush x:Key="CatroWarmSoftBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Style x:Key="CatroEyebrowTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="80" />
                <Setter Property="Foreground" Value="{ThemeResource CatroTextTertiaryBrush}" />
            </Style>

            <Style x:Key="CatroPageTitleTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource CatroTextBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="CatroSectionTitleTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="17" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource CatroTextBrush}" />
            </Style>

            <Style x:Key="CatroBodyTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="{ThemeResource CatroTextBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="CatroSecondaryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CatroBodyTextStyle}">
                <Setter Property="Foreground" Value="{ThemeResource CatroTextSecondaryBrush}" />
            </Style>

            <Style x:Key="CatroCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CatroSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CatroStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="14" />
            </Style>

            <Style x:Key="CatroSoftCardStyle" TargetType="Border" BasedOn="{StaticResource CatroCardStyle}">
                <Setter Property="Background" Value="{ThemeResource CatroSurfaceAltBrush}" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>

            <!-- Based on AccentButtonStyle so hover, pressed, disabled and on-accent text all come
                 from the theme instead of falling back to the stock gray button states. -->
            <Style x:Key="CatroPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="16,8" />
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="CatroSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="{ThemeResource CatroSurfaceAltBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource CatroTextBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CatroStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="14,7" />
                <Setter Property="MinHeight" Value="36" />
            </Style>

            <Style x:Key="CatroNavButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Width" Value="48" />
                <Setter Property="Height" Value="48" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{ThemeResource CatroTextSecondaryBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>

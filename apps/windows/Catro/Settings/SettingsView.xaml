<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Catro.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="900"
                    Padding="32,28,32,36"
                    Spacing="22">
            <StackPanel Spacing="6">
                <TextBlock Text="PREFERENCES" Style="{StaticResource CatroEyebrowTextStyle}" />
                <TextBlock Text="Small surface, strong defaults."
                           Style="{StaticResource CatroPageTitleTextStyle}"
                           AutomationProperties.HeadingLevel="Level1" />
                <TextBlock Text="Settings stay intentionally compact. Device detail lives in System; only product decisions belong here."
                           MaxWidth="650"
                           Style="{StaticResource CatroSecondaryTextStyle}" />
            </StackPanel>

            <Border Style="{StaticResource CatroCardStyle}">
                <StackPanel>
                    <Grid Padding="18,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3">
                            <TextBlock Text="Appearance"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource CatroTextBrush}" />
                            <TextBlock Text="Follow the system theme by default."
                                       Style="{StaticResource CatroSecondaryTextStyle}" />
                        </StackPanel>
                        <Border Grid.Column="1"
                                Padding="10,5"
                                CornerRadius="10"
                                Background="{ThemeResource CatroSurfaceAltBrush}">
                            <TextBlock Text="SYSTEM"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource CatroTextSecondaryBrush}" />
                        </Border>
                    </Grid>
                    <Border Height="1" Background="{ThemeResource CatroStrokeBrush}" />
                    <Grid Padding="18,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3">
                            <TextBlock Text="Voice devices"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource CatroTextBrush}" />
                            <TextBlock Text="Use Windows communication defaults until explicitly changed."
                                       Style="{StaticResource CatroSecondaryTextStyle}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Text="System defaults"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource CatroSecondaryTextStyle}" />
                    </Grid>
                    <Border Height="1" Background="{ThemeResource CatroStrokeBrush}" />
                    <Grid Padding="18,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3">
                            <TextBlock Text="Performance"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource CatroTextBrush}" />
                            <TextBlock Text="Keep UI effects minimal and let the media core own realtime priority."
                                       Style="{StaticResource CatroSecondaryTextStyle}" />
                        </StackPanel>
                        <Border Grid.Column="1"
                                Padding="10,5"
                                CornerRadius="10"
                                Background="{ThemeResource CatroSageSoftBrush}">
                            <TextBlock Text="LEAN"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource CatroSageBrush}" />
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CatroSoftCardStyle}" Padding="18">
                <StackPanel Spacing="5">
                    <TextBlock Text="Connection points are reserved."
                               Style="{StaticResource CatroSectionTitleTextStyle}" />
                    <TextBlock Text="These rows intentionally have no persistence yet. They define stable UX boundaries before account, room, capture, and production transport work arrives."
                               Style="{StaticResource CatroSecondaryTextStyle}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

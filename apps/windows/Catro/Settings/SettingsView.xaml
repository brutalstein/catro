<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Catro.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{ThemeResource CatroBackgroundBrush}">
        <StackPanel MaxWidth="620"
                    Padding="28"
                    Spacing="14"
                    HorizontalAlignment="Stretch">
            <TextBlock Text="Settings"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="{ThemeResource CatroTextBrush}"
                       AutomationProperties.HeadingLevel="Level1" />

            <Border Style="{StaticResource CatroCardStyle}">
                <StackPanel>
                    <Grid Padding="16,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Appearance"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource CatroTextBrush}" />
                        <ComboBox x:Name="AppearanceBox"
                                  Grid.Column="1"
                                  MinWidth="140"
                                  SelectionChanged="OnAppearanceChanged"
                                  AutomationProperties.Name="Appearance">
                            <ComboBoxItem Content="Ivory" />
                            <ComboBoxItem Content="Dark" />
                            <ComboBoxItem Content="System" />
                        </ComboBox>
                    </Grid>
                    <Border Height="1" Background="{ThemeResource CatroStrokeBrush}" />
                    <Grid Padding="16,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Microphone"
                                   Foreground="{ThemeResource CatroTextBrush}" />
                        <TextBlock Grid.Column="1"
                                   Text="Default"
                                   Foreground="{ThemeResource CatroTextSecondaryBrush}" />
                    </Grid>
                    <Border Height="1" Background="{ThemeResource CatroStrokeBrush}" />
                    <Grid Padding="16,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Output"
                                   Foreground="{ThemeResource CatroTextBrush}" />
                        <TextBlock Grid.Column="1"
                                   Text="Default"
                                   Foreground="{ThemeResource CatroTextSecondaryBrush}" />
                    </Grid>
                    <Border Height="1" Background="{ThemeResource CatroStrokeBrush}" />
                    <Grid Padding="16,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Performance"
                                   Foreground="{ThemeResource CatroTextBrush}" />
                        <Border Grid.Column="1"
                                Padding="8,3"
                                CornerRadius="8"
                                Background="{ThemeResource CatroSageSoftBrush}">
                            <TextBlock Text="BALANCED"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       CharacterSpacing="60"
                                       Foreground="{ThemeResource CatroSageBrush}" />
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>

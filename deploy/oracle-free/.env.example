# install.sh creates .env with fresh secrets. Values below are non-secret
# validation examples only.
CATRO_HOSTNAME=catro.example.com
CATRO_PUBLIC_IP=203.0.113.10
CATRO_PRIVATE_IP=10.0.0.10
CATRO_SIGNALING_SECRET=EXAMPLE_ONLY_SIGNALING_SECRET_0123456789abcdef0123456789abcdef
CATRO_TURN_SECRET=EXAMPLE_ONLY_TURN_SECRET_0123456789abcdef0123456789abcdef
CATRO_MAX_ROOM_PEERS=5
CATRO_API_WRITES_PER_MINUTE=30
CATRO_DISCOVERY_READS_PER_MINUTE=30
CATRO_TURN_MIN_PORT=49160
CATRO_TURN_MAX_PORT=49200
CATRO_IMAGE_TAG=prod
CATRO_STATE_DIR=/var/lib/catro/signaling
CATRO_BACKUP_DIR=/var/backups/catro
CATRO_CADDY_DATA_DIR=/var/lib/catro/caddy-data
CATRO_CADDY_CONFIG_DIR=/var/lib/catro/caddy-config
